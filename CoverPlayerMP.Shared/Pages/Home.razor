@page "/"
@implements IAsyncDisposable
@inject IPlaylistPlayer Player
@inject IJSRuntime Js
@inject AppText Text
@inject CoverSearch CoverSearcher
@inject IServiceProvider Services

<PageTitle>CoverPlayerMP</PageTitle>

<div class="player-shell" @onclick="ShowControls">
    <div class="bottom-hotspot" @onmouseenter="ShowControls"></div>
    @if (WindowControls is { } windowControls)
    {
        <div class="window-hotspot" @onmouseenter="UpdateWindowButtons">
            @if (windowButtonsVisible)
            {
            <div class="window-buttons">
                <button title="Restore" aria-label="Restore" @onclick="RestoreWindow" @onclick:stopPropagation="true">&#x2750;</button>
                <button class="window-close" title="Close" aria-label="Close" @onclick="windowControls.Close" @onclick:stopPropagation="true">&times;</button>
            </div>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Player.ErrorMessage))
    {
        <div class="player-error" role="alert">@Player.ErrorMessage</div>
    }
    <div class="cover-stage"
         @onpointerdown="OnSwipeStart"
         @onpointerup="OnSwipeEndAsync"
         @onpointercancel="() => swipeStart = null">
        <canvas class="cover-image" @ref="coverCanvas"></canvas>
        @if (string.IsNullOrWhiteSpace(coverUri))
        {
            <div class="cover-placeholder">♪</div>
        }
    </div>
    <div class="track-caption">
        <span>@(Player.CurrentTrack?.Artist ?? "CoverPlayerMP")</span>
        <span class="caption-separator">—</span>
        <span>@(Player.CurrentTrack?.Title ?? Text.SelectPlaylist)</span>
        @if (Player.CurrentTrack is not null)
        {
            <button class="info-button" title="@Text.TrackDetails" aria-label="@Text.TrackDetails"
                    @onclick="ShowTrackInfo" @onclick:stopPropagation="true">i</button>
        }
    </div>

    @if (controlsVisible)
    {
        <section class="control-dialog" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@Text.PlayerControls</span>
                <button class="close-button" title="@Text.Settings" aria-label="@Text.Settings" @onclick="OpenOptions">
                    <svg viewBox="0 0 24 24" width="0.8em" height="0.8em" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6a.5.5 0 0 0 .1-.6l-2-3.5a.5.5 0 0 0-.6-.2l-2.5 1a7.3 7.3 0 0 0-1.7-1l-.4-2.6a.5.5 0 0 0-.5-.4h-4a.5.5 0 0 0-.5.4l-.4 2.6a7.3 7.3 0 0 0-1.7 1l-2.5-1a.5.5 0 0 0-.6.2l-2 3.5a.5.5 0 0 0 .1.6L4.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6a.5.5 0 0 0-.1.6l2 3.5a.5.5 0 0 0 .6.2l2.5-1a7.3 7.3 0 0 0 1.7 1l.4 2.6a.5.5 0 0 0 .5.4h4a.5.5 0 0 0 .5-.4l.4-2.6a7.3 7.3 0 0 0 1.7-1l2.5 1a.5.5 0 0 0 .6-.2l2-3.5a.5.5 0 0 0-.1-.6zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" />
                    </svg>
                </button>
                <button class="close-button" title="@Text.HideControls" aria-label="@Text.HideControls" @onclick="HideControls">×</button>
            </div>
            <div class="control-row timeline-row">
                <span>@FormatTime(displayPosition)</span>
                <input type="range"
                       @key="Player.CurrentIndex"
                       min="0"
                       max="@durationValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1"
                       value="@displayPosition.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onpointerdown="BeginSeeking"
                       @onpointerup="EndSeeking"
                       @onpointercancel="EndSeeking"
                       @oninput="OnSeekChanged" />
                <span>@FormatTime(Player.Duration)</span>
            </div>
            <div class="control-toolbar">
                <div class="control-buttons">
                <div class="playlist-buttons">
                <button @onclick="OpenPlaylistAsync"
                        title="@Text.OpenPlaylist" aria-label="@Text.OpenPlaylist">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5V9H6.2a1.5 1.5 0 0 0-1.4 1L3 15.5z" />
                                                <path d="M5.6 11a1 1 0 0 1 .9-.7h15.2a.8.8 0 0 1 .8 1l-2.1 7a1 1 0 0 1-1 .7H3.8a.8.8 0 0 1-.8-1z" />
                                            </svg>
                                        </button>
                <button @onclick="OpenEditor" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.EditPlaylist" aria-label="@Text.EditPlaylist">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <rect x="3" y="5" width="11" height="2" rx="1" />
                        <rect x="3" y="10" width="11" height="2" rx="1" />
                        <rect x="3" y="15" width="6" height="2" rx="1" />
                        <path d="M18.6 9.2l2.2 2.2-7.3 7.3-2.9.7.7-2.9z" />
                    </svg>
                </button>
                <button @onclick="OpenLibraryAsync"
                        title="@Text.SearchAudioFiles" aria-label="@Text.SearchAudioFiles">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <circle cx="10" cy="10" r="6.5" />
                        <path d="M15 15l6 6" />
                    </svg>
                </button>
                </div>
                <div class="player-buttons">
                <button @onclick="PreviousAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.Previous" aria-label="@Text.Previous">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <rect x="4" y="4" width="3" height="16" rx="1" />
                                                <path d="M20 4.5v15a.8.8 0 0 1-1.2.7L8.5 12.7a.8.8 0 0 1 0-1.4l10.3-7.5a.8.8 0 0 1 1.2.7z" />
                                            </svg>
                                        </button>
                <button @onclick="RestartAsync" disabled="@(Player.CurrentTrack is null)"
                        title="@Text.Restart" aria-label="@Text.Restart">&#x21BA;&#xFE0E;</button>
                <button class="play-button" @onclick="TogglePauseAsync" disabled="@(Player.CurrentTrack is null)"
                        title="@(Player.IsPlaying ? Text.Pause : Text.Play)"
                        aria-label="@(Player.IsPlaying ? Text.Pause : Text.Play)">
                    @if (Player.IsPlaying)
                    {
                        <svg class="pause-icon" viewBox="0 0 24 24" width="1em" height="1em"
                             fill="currentColor" aria-hidden="true" focusable="false"
                             style="vertical-align: -0.125em;">
                            <rect x="5" y="4" width="5" height="16" rx="1" />
                            <rect x="14" y="4" width="5" height="16" rx="1" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                             aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                            <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                        </svg>
                    }
                </button>
                <button @onclick="NextAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.Next" aria-label="@Text.Next">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M4 4.5v15a.8.8 0 0 0 1.2.7l10.3-7.5a.8.8 0 0 0 0-1.4L5.2 3.8A.8.8 0 0 0 4 4.5z" />
                                                <rect x="17" y="4" width="3" height="16" rx="1" />
                                            </svg>
                                        </button>
                </div>
                </div>
                <label class="setting-row setting-inline volume-setting">
                    <span class="setting-icon"
                           title="@Text.Volume"
                           aria-label="@Text.Volume">🔊</span>
                    <span class="setting-value">@Math.Round(Player.Volume * 100) %</span>
                    <input type="range" min="0" max="1" step="0.01"
                           title="@Text.VolumePercent(Math.Round(Player.Volume * 100))"
                           value="@Player.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @oninput="OnVolumeChanged" />
                </label>
            </div>
        </section>
    }

    @if (libraryVisible)
    {
        <section class="library-dialog" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@Text.AudioFiles (@FilteredLibrary.Count() @Text.Of @libraryTracks.Count)</span>
                <button class="close-button" title="@Text.Close" @onclick="CloseLibrary">×</button>
            </div>
            @if (libraryLoading)
            {
                <div class="library-status">@Text.ReadingAudioFiles</div>
            }
            else
            {
                <div class="library-table-wrapper">
                    <table class="library-table">
                        <thead>
                            <tr>
                                <th><input placeholder="@Text.Artist" @bind="artistFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="@Text.Title" @bind="titleFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="@Text.DurationFilterPlaceholder" @bind="durationFilter" @bind:event="oninput" /></th>
                            </tr>
                            <tr>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Artist)">@Text.Artist@(SortIndicator(LibrarySortColumn.Artist))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Title)">@Text.Title@(SortIndicator(LibrarySortColumn.Title))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Duration)">@Text.Duration@(SortIndicator(LibrarySortColumn.Duration))</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredLibrary)
                            {
                                <tr @onclick="() => SelectLibraryTrackAsync(item)">
                                    <td>@item.Track.Artist</td>
                                    <td>@item.Track.Title</td>
                                    <td>@FormatTime(item.Duration.TotalSeconds)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (editorVisible && !libraryVisible)
    {
        <section class="library-dialog" style="--editor-cover-size: @(editorCoverSize)rem;" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@Text.EditPlaylist (@FilteredPlaylist.Count() @Text.Of @Player.Tracks.Count)</span>
                <button class="close-button" title="@Text.Close" @onclick="CloseEditor">×</button>
            </div>
            <div class="editor-toolbar">
                <input class="editor-search" type="search" placeholder="@Text.Search"
                       @bind="editorSearch" @bind:event="oninput" />
                <button @onclick="RemoveSelectedTrackAsync" disabled="@(!CanRemoveSelected)"
                        title="@Text.RemoveTrack" aria-label="@Text.RemoveTrack">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <path d="M9 3h6l1 2h4v2H4V5h4z" />
                        <path d="M6 9h12l-1 11.2a1 1 0 0 1-1 .8H8a1 1 0 0 1-1-.8z" />
                    </svg>
                </button>
                <button @onclick="OpenLibraryAsync" title="@Text.AddTrack" aria-label="@Text.AddTrack">+</button>
                <button @onclick="ShowSelectedTrackInfo" disabled="@(SelectedTrack is null)"
                        title="@Text.TrackDetails" aria-label="@Text.TrackDetails">i</button>
            </div>
            @if (selectionMode)
            {
                <div class="selection-toolbar">
                    <span>@Text.Selected(selectedIndices.Count)</span>
                    <button @onclick="SelectAllVisible" title="@Text.SelectAll" aria-label="@Text.SelectAll">@Text.All</button>
                    <button @onclick="EndSelectionMode" title="@Text.EndSelection" aria-label="@Text.EndSelection">×</button>
                </div>
            }
            <div class="library-table-wrapper">
                <table class="library-table editor-table">
                    <thead>
                        <tr>
                            <th class="editor-grip-cell"></th>
                            @if (selectionMode)
                            {
                                <th class="editor-check-cell"></th>
                            }
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Position)">@Text.No@(EditorSortIndicator(EditorSortColumn.Position))</th>
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Artist)">@Text.Artist@(EditorSortIndicator(EditorSortColumn.Artist))</th>
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Title)">@Text.Title@(EditorSortIndicator(EditorSortColumn.Title))</th>
                            <th>@Text.Cover</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (track, index) in FilteredPlaylist)
                        {
                            var details = GetEditorDetails(track);
                            <tr @key="track" class="@EditorRowClass(index)" @onclick="e => SelectRow(index, e)"
                                @onpointerdown="e => BeginLongPress(index, e)"
                                @onpointermove="MoveLongPress"
                                @onpointerup="CancelLongPress"
                                @onpointercancel="CancelLongPress"
                                @onpointerleave="CancelLongPress"
                                @oncontextmenu:preventDefault="true"
                                @ondragenter="() => dropIndex = index"
                                @ondragover:preventDefault="true"
                                @ondrop="() => DropTrack(index)">
                                <td class="editor-grip-cell">
                                    <span class="editor-grip" draggable="@(editingIndex is null ? "true" : "false")"
                                           title="@Text.Move" aria-label="@Text.Move"
                                          @onpointerdown:stopPropagation="true"
                                          @onclick:stopPropagation="true"
                                          @ondragstart="() => BeginDrag(index)"
                                          @ondragend="EndDrag">≡</span>
                                </td>
                                @if (selectionMode)
                                {
                                    <td class="editor-check-cell">
                                        <input type="checkbox" checked="@selectedIndices.Contains(index)" tabindex="-1"
                                               aria-label="@Text.Select" style="pointer-events: none;" />
                                    </td>
                                }
                                <td class="editor-position" @onclick="() => { if (!selectionMode) BeginEditPosition(index); }">
                                    @if (editingIndex == index)
                                    {
                                        <input type="number" min="1" max="@Player.Tracks.Count"
                                               @bind="editingValue" @bind:event="oninput"
                                               @onkeydown="OnPositionKeyDown" @onblur="CommitPosition"
                                               @onclick:stopPropagation="true" autofocus />
                                    }
                                    else
                                    {
                                        @(index + 1)
                                    }
                                </td>
                                <td>@track.Artist</td>
                                <td>@track.Title</td>
                                <td class="editor-cover-cell">
                                    <button class="editor-cover" title="@Text.PlayTrack" aria-label="@Text.PlayTrack"
                                            @onclick="() => PlayFromEditorAsync(index)">
                                        @if (details.Cover is not null)
                                        {
                                            <img src="@details.Cover" alt="" />
                                        }
                                        else
                                        {
                                            <span class="editor-cover-placeholder">♪</span>
                                        }
                                        <span class="editor-cover-play">
                                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                                <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                                            </svg>
                                        </span>
                                        @if (details.Duration is { } duration)
                                        {
                                            <span class="editor-cover-duration">@FormatTime(duration.TotalSeconds)</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (removingTrack is not null)
    {
        <div class="insert-overlay busy-overlay" @onclick:stopPropagation="true">
            <section class="insert-dialog" role="alertdialog" aria-live="assertive">
                <span class="busy-spinner" aria-hidden="true"></span>
                <span>@removingTrack</span>
            </section>
        </div>
    }

    @if (pendingTrack is not null)
    {
        <div class="insert-overlay" @onclick:stopPropagation="true">
            <section class="insert-dialog">
                <div class="control-dialog-header">
                    <span>@Text.InsertTrack(pendingTrack.Title)</span>
                    <button class="close-button" title="@Text.Cancel" @onclick="() => pendingTrack = null">×</button>
                </div>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.Start)">@Text.InsertAtStart</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.BeforeCurrent)">@Text.InsertBeforeCurrent</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.AfterCurrent)">@Text.InsertAfterCurrent</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.AfterCurrentAndPlay)">@Text.InsertAfterCurrentAndPlay</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.End)">@Text.InsertAtEnd</button>
            </section>
        </div>
    }

    @if (trackInfo is not null)
    {
        <div class="insert-overlay" @onclick="CloseTrackInfo" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.TrackDetails</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseTrackInfo">×</button>
                </div>
                <dl class="info-list">
                    @foreach (var entry in trackInfo)
                    {
                        <dt>@entry.Key</dt>
                        <dd>
                            @entry.Value
                            @if (entry.Key == Text.MetaTagTypes)
                            {
                                <button class="info-button info-inline" title="@Text.TagContents" aria-label="@Text.TagContents"
                                        @onclick="ShowRawTags">i</button>
                            }
                            @if (entry.Key == Text.CoverPictures)
                            {
                                <button class="info-button info-inline" title="@Text.ShowCoverPictures" aria-label="@Text.ShowCoverPictures"
                                        @onclick="ShowPictures">i</button>
                            }
                        </dd>
                    }
                </dl>
            </section>
        </div>
    }

    @if (rawTags is not null)
    {
        <div class="insert-overlay" @onclick="CloseRawTags" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.TagContents</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseRawTags">×</button>
                </div>
                <dl class="info-list">
                    @if (rawTags.Count == 0)
                    {
                        <dd>@Text.NoTags</dd>
                    }
                    @foreach (var entry in rawTags)
                    {
                        <dt>@entry.Key</dt>
                        <dd>@entry.Value</dd>
                    }
                </dl>
            </section>
        </div>
    }
    @if (pictures is not null)
    {
        <div class="insert-overlay" @onclick="ClosePictures" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.CoverPictures</span>
                    <button class="close-button" title="@Text.Close" @onclick="ClosePictures">×</button>
                </div>
                <div class="animation-toolbar">
                    <button @onclick="StartCoverSearchAsync">@ChangeLabel</button>
                    @if (newCover is not null)
                    {
                        <button class="play-button" @onclick="ApplyCover">@Text.Apply</button>
                    }
                </div>
                @if (coverSearching)
                {
                    <span>@CoverSearchWaitingLabel</span>
                }
                <div class="picture-list">
                    @if (newCover is not null)
                    {
                        <figure>
                            <img src="@newCover" alt="Cover.jpg" />
                            <figcaption>Cover.jpg</figcaption>
                        </figure>
                    }
                    @if (pictures.Count == 0)
                    {
                        <span>@Text.NoCoverPictures</span>
                    }
                    @foreach (var picture in pictures)
                    {
                        <figure>
                            <img src="@picture.Value" alt="@picture.Key" />
                            <figcaption>@picture.Key</figcaption>
                        </figure>
                    }
                </div>
            </section>
        </div>
    }
    @if (optionsVisible)
    {
        <div class="insert-overlay" @onclick="CloseOptions" @onclick:stopPropagation="true">
            <section class="insert-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.Settings</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseOptions">×</button>
                </div>
                @if (!quitConfirmVisible)
                {
                    <label class="setting-row">
                        <span>@Text.Crossfade</span>
                        <input type="range" min="0" max="5" step="0.1"
                               title="@Text.CrossfadeTooltip(Player.CrossfadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))"
                               value="@Player.CrossfadeSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               disabled="@(!Player.SupportsCrossfade)"
                               @oninput="OnCrossfadeChanged" />
                        <span class="setting-value">@Player.CrossfadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) s</span>
                        @if (!Player.SupportsCrossfade)
                        {
                            <small class="setting-hint">@Text.CrossfadeUnsupported</small>
                        }
                    </label>
                    <label class="setting-row">
                        <span>@Text.CoverFade</span>
                        <input type="range" min="0" max="5" step="0.1"
                               title="@Text.CrossfadeTooltip(coverFadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))"
                               value="@coverFadeSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="OnCoverFadeChanged" />
                        <span class="setting-value">@coverFadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) s</span>
                    </label>
                    <label class="setting-row">
                        <span>@Text.CoverSize</span>
                        <input type="range" min="3" max="12" step="1"
                               title="@Text.CoverSizeTooltip(editorCoverSize)"
                               value="@editorCoverSize"
                               @oninput="OnEditorCoverSizeChanged" />
                        <span class="setting-value">@editorCoverSize rem</span>
                    </label>
                    <label class="setting-row">
                        <span>@Text.LanguageLabel</span>
                        <select value="@Text.Language" @onchange="OnLanguageChanged">
                            <option value="@AppLanguage.Auto">@Text.LanguageAuto</option>
                            <option value="@AppLanguage.German">Deutsch</option>
                            <option value="@AppLanguage.English">English</option>
                            <option value="@AppLanguage.French">Français</option>
                        </select>
                    </label>
                    <button @onclick="OpenAnimationsAsync">@Text.Animations</button>
                    @if (Player.SupportsRemotePlayback)
                    {
                        <button @onclick="OpenRemoteDevicesAsync">@Text.RemotePlayback</button>
                    }
                    @if (Player.CanQuit)
                    {
                        <button @onclick="RequestQuit">@Text.QuitApp</button>
                    }
                    else if (Player.IsPlaylistModified)
                    {
                        <button @onclick="SaveOnlyAsync">@Text.SavePlaylist</button>
                    }
                }
                else
                {
                    <span>@Text.SaveBeforeQuit</span>
                    <button @onclick="() => QuitAsync(true)">@Text.SaveAndQuit</button>
                    <button @onclick="() => QuitAsync(false)">@Text.QuitWithoutSaving</button>
                    <button @onclick="() => quitConfirmVisible = false">@Text.Cancel</button>
                }
            </section>
        </div>
    }
    @if (animationChoices is not null)
    {
        <div class="insert-overlay" @onclick="CloseAnimations" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.Animations (@animationChoices.Count(a => a.Active) @Text.Of @animationChoices.Count)</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseAnimations">×</button>
                </div>
                <div class="animation-toolbar">
                    <button @onclick="() => SetAllAnimations(true)">@Text.All</button>
                    <button @onclick="() => SetAllAnimations(false)">@Text.None</button>
                </div>
                <div class="animation-list">
                    @foreach (var group in animationChoices.GroupBy(a => a.Group))
                    {
                        <label class="animation-group">
                            <input type="checkbox" checked="@group.All(a => a.Active)"
                                   @onchange="e => SetGroup(group.Key, e.Value is true)" />
                            @group.Key
                        </label>
                        @foreach (var choice in group)
                        {
                            <label class="animation-item">
                                <input type="checkbox" @bind="choice.Active" />
                                @choice.Label
                            </label>
                        }
                    }
                </div>
                <div class="animation-toolbar">
                    <button class="play-button" @onclick="SaveAnimationsAsync">@Text.Apply</button>
                    <button @onclick="CloseAnimations">@Text.Cancel</button>
                </div>
            </section>
        </div>
    }
    @if (remoteDialogVisible)
    {
        <div class="insert-overlay" @onclick="CloseRemoteDialog" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.RemotePlayback</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseRemoteDialog">×</button>
                </div>
                <div class="remote-list">
                    <button class="remote-device @(Player.ActiveDevice is null ? "active" : null)" @onclick="() => SelectRemoteDeviceAsync(null)">
                        <span>@Text.RemoteThisDevice</span>
                    </button>
                    @if (remoteDevices is not null)
                    {
                        @foreach (var device in remoteDevices)
                        {
                            <button class="remote-device @(Player.ActiveDevice?.Id == device.Id ? "active" : null)" @onclick="() => SelectRemoteDeviceAsync(device)">
                                <span>@device.Name</span>
                                <span class="remote-connection">@device.Connection</span>
                            </button>
                        }
                        @if (remoteDevices.Count == 0)
                        {
                            <span>@Text.RemoteNoDevices</span>
                        }
                    }
                    else if (remoteSearching)
                    {
                        <span>@Text.RemoteSearching</span>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
