    private bool HandleBack()
    {
        if (removingTrack is not null)
            return true;
        if (selectionMode && editorVisible && !libraryVisible && pendingTrack is null &&
            trackInfo is null && rawTags is null && pictures is null)
        {
            _ = InvokeAsync(() => { EndSelectionMode(); StateHasChanged(); });
            return true;
        }
        if (remoteDialogVisible)
        {
            _ = InvokeAsync(() => { remoteDialogVisible = false; StateHasChanged(); });
            return true;
        }
        if (animationChoices is not null)
        {
            _ = InvokeAsync(() => { animationChoices = null; StateHasChanged(); });
            return true;
        }
        if (optionsVisible)
        {
            _ = InvokeAsync(() => { CloseOptions(); StateHasChanged(); });
            return true;
        }
        if (pictures is not null)
        {
            _ = InvokeAsync(() => { pictures = null; StateHasChanged(); });
            return true;
        }
        if (rawTags is not null)
        {
            _ = InvokeAsync(() => { rawTags = null; StateHasChanged(); });
            return true;
        }
        if (trackInfo is not null)
        {
            _ = InvokeAsync(() => { trackInfo = null; StateHasChanged(); });
            return true;
        }
        if (editorVisible && !libraryVisible && pendingTrack is null)
        {
            _ = InvokeAsync(() => { CloseEditor(); StateHasChanged(); });
            return true;
        }

        if (pendingTrack is null && !libraryVisible)
            return false;

        _ = InvokeAsync(() =>
        {
            if (pendingTrack is not null)
                pendingTrack = null;
            else
                libraryVisible = false;
            StateHasChanged();
        });
        return true;
    }

    private static bool IsShutdownException(Exception ex)
    {
        return ex is JSException
            || ex is Microsoft.JSInterop.JSDisconnectedException
            || ex is TaskCanceledException
            || ex is ObjectDisposedException
            || ex is InvalidOperationException
            || ex is System.Runtime.InteropServices.COMException;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (coverChanged && !disposed)
            {
                coverChanged = false;
                var duration = (int)Math.Round(Math.Max(0.6, coverFadeSeconds) * 1000);
                await Js.InvokeVoidAsync("coverTransition.show", coverCanvas, coverUri, duration);
            }

            if (!firstRender || disposed)
                return;

            await LoadSettingsAsync();

            keyboardReference = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("coverPlayerKeyboard.register", keyboardReference);
        }
        catch (Exception ex) when (disposed || IsShutdownException(ex))
        {
        }
    }

    private const string CrossfadeKey = "coverPlayer.crossfadeSeconds";
    private const string CoverFadeKey = "coverPlayer.coverFadeSeconds";
    private double coverFadeSeconds = 2;
    private const string EditorCoverSizeKey = "coverPlayer.editorCoverSize";
    private const string LanguageKey = "coverPlayer.language";

    private async Task OnLanguageChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<AppLanguage>(args.Value?.ToString(), out var language))
        {
            Text.Language = language;
            await SaveSettingAsync(LanguageKey, language.ToString());
        }
    }

    private void OnLanguageChangedEvent(object? sender, EventArgs e)
    {
        if (infoSource is not null && trackInfo is not null)
            trackInfo = TrackMetadata.Read(infoSource, Text);
        if (infoSource is not null && rawTags is not null)
            rawTags = TrackMetadata.ReadRawTags(infoSource, Text);
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (disposed)
                    return;
                await Js.InvokeVoidAsync("document.documentElement.setAttribute", "lang", Text.Code);
                StateHasChanged();
            }
            catch (Exception ex) when (disposed || IsShutdownException(ex))
            {
            }
        });
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var crossfade = await Js.InvokeAsync<string?>("localStorage.getItem", CrossfadeKey);
            if (double.TryParse(crossfade, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var seconds))
                Player.CrossfadeSeconds = Math.Clamp(seconds, 0, 5);

            var coverFade = await Js.InvokeAsync<string?>("localStorage.getItem", CoverFadeKey);
            if (double.TryParse(coverFade, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var fadeSeconds))
                coverFadeSeconds = Math.Clamp(fadeSeconds, 0, 5);

            var coverSize = await Js.InvokeAsync<string?>("localStorage.getItem", EditorCoverSizeKey);
            if (int.TryParse(coverSize, out var size))
                editorCoverSize = Math.Clamp(size, 3, 12);

            var language = await Js.InvokeAsync<string?>("localStorage.getItem", LanguageKey);
            if (Enum.TryParse<AppLanguage>(language, out var appLanguage))
                Text.Language = appLanguage;
            await Js.InvokeVoidAsync("document.documentElement.setAttribute", "lang", Text.Code);

            StateHasChanged();
        }
        catch (Exception ex) when (disposed || IsShutdownException(ex))
        {
        }
    }

    private async Task SaveSettingAsync(string key, string value)
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", key, value);
        }
        catch (Exception ex) when (disposed || IsShutdownException(ex))
        {
        }
    }

