@page "/"
@implements IAsyncDisposable
@inject IPlaylistPlayer Player
@inject IJSRuntime Js

<PageTitle>CoverPlayerMP</PageTitle>

<div class="player-shell" @onclick="ShowControls">
    <div class="bottom-hotspot" @onmouseenter="ShowControls"></div>
    @if (!string.IsNullOrWhiteSpace(Player.ErrorMessage))
    {
        <div class="player-error" role="alert">@Player.ErrorMessage</div>
    }
    <div class="cover-stage"
         @onpointerdown="OnSwipeStart"
         @onpointerup="OnSwipeEndAsync"
         @onpointercancel="() => swipeStart = null">
        <canvas class="cover-image" @ref="coverCanvas"></canvas>
        @if (string.IsNullOrWhiteSpace(coverUri))
        {
            <div class="cover-placeholder">♪</div>
        }
    </div>
    <div class="track-caption">
        <span>@(Player.CurrentTrack?.Artist ?? "CoverPlayerMP")</span>
        <span class="caption-separator">—</span>
        <span>@(Player.CurrentTrack?.Title ?? "Playlist auswählen")</span>
        @if (Player.CurrentTrack is not null)
        {
            <button class="info-button" title="Details zum Lied" aria-label="Details zum Lied"
                    @onclick="ShowTrackInfo" @onclick:stopPropagation="true">i</button>
        }
    </div>

    @if (controlsVisible)
    {
        <section class="control-dialog" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>Player-Steuerung</span>
                <button class="close-button" title="Einstellungen" aria-label="Einstellungen" @onclick="OpenOptions">
                    <svg viewBox="0 0 24 24" width="0.8em" height="0.8em" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6a.5.5 0 0 0 .1-.6l-2-3.5a.5.5 0 0 0-.6-.2l-2.5 1a7.3 7.3 0 0 0-1.7-1l-.4-2.6a.5.5 0 0 0-.5-.4h-4a.5.5 0 0 0-.5.4l-.4 2.6a7.3 7.3 0 0 0-1.7 1l-2.5-1a.5.5 0 0 0-.6.2l-2 3.5a.5.5 0 0 0 .1.6L4.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6a.5.5 0 0 0-.1.6l2 3.5a.5.5 0 0 0 .6.2l2.5-1a7.3 7.3 0 0 0 1.7 1l.4 2.6a.5.5 0 0 0 .5.4h4a.5.5 0 0 0 .5-.4l.4-2.6a7.3 7.3 0 0 0 1.7-1l2.5 1a.5.5 0 0 0 .6-.2l2-3.5a.5.5 0 0 0-.1-.6zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" />
                    </svg>
                </button>
                <button class="close-button" title="Steuerung ausblenden" aria-label="Steuerung ausblenden" @onclick="HideControls">×</button>
            </div>
            <div class="control-row timeline-row">
                <span>@FormatTime(displayPosition)</span>
                <input type="range"
                       @key="Player.CurrentIndex"
                       min="0"
                       max="@durationValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1"
                       value="@displayPosition.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onpointerdown="BeginSeeking"
                       @onpointerup="EndSeeking"
                       @onpointercancel="EndSeeking"
                       @oninput="OnSeekChanged" />
                <span>@FormatTime(Player.Duration)</span>
            </div>
            <div class="control-toolbar">
                <div class="control-buttons">
                <div class="playlist-buttons">
                <button @onclick="OpenPlaylistAsync"
                        title="Playlist öffnen" aria-label="Playlist öffnen">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5V9H6.2a1.5 1.5 0 0 0-1.4 1L3 15.5z" />
                                                <path d="M5.6 11a1 1 0 0 1 .9-.7h15.2a.8.8 0 0 1 .8 1l-2.1 7a1 1 0 0 1-1 .7H3.8a.8.8 0 0 1-.8-1z" />
                                            </svg>
                                        </button>
                <button @onclick="OpenEditor" disabled="@(Player.Tracks.Count == 0)"
                        title="Playlist bearbeiten" aria-label="Playlist bearbeiten">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <rect x="3" y="5" width="11" height="2" rx="1" />
                        <rect x="3" y="10" width="11" height="2" rx="1" />
                        <rect x="3" y="15" width="6" height="2" rx="1" />
                        <path d="M18.6 9.2l2.2 2.2-7.3 7.3-2.9.7.7-2.9z" />
                    </svg>
                </button>
                <button @onclick="OpenLibraryAsync"
                        title="Audiodateien suchen" aria-label="Audiodateien suchen">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <circle cx="10" cy="10" r="6.5" />
                        <path d="M15 15l6 6" />
                    </svg>
                </button>
                </div>
                <button @onclick="PreviousAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="Vorheriges" aria-label="Vorheriges">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <rect x="4" y="4" width="3" height="16" rx="1" />
                                                <path d="M20 4.5v15a.8.8 0 0 1-1.2.7L8.5 12.7a.8.8 0 0 1 0-1.4l10.3-7.5a.8.8 0 0 1 1.2.7z" />
                                            </svg>
                                        </button>
                <button @onclick="RestartAsync" disabled="@(Player.CurrentTrack is null)"
                        title="Anfang" aria-label="Anfang">&#x21BA;&#xFE0E;</button>
                <button class="play-button" @onclick="TogglePauseAsync" disabled="@(Player.CurrentTrack is null)"
                        title="@(Player.IsPlaying ? "Pause" : "Wiedergabe")"
                        aria-label="@(Player.IsPlaying ? "Pause" : "Wiedergabe")">
                    @if (Player.IsPlaying)
                    {
                        <svg class="pause-icon" viewBox="0 0 24 24" width="1em" height="1em"
                             fill="currentColor" aria-hidden="true" focusable="false"
                             style="vertical-align: -0.125em;">
                            <rect x="5" y="4" width="5" height="16" rx="1" />
                            <rect x="14" y="4" width="5" height="16" rx="1" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                             aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                            <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                        </svg>
                    }
                </button>
                <button @onclick="NextAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="Nächstes" aria-label="Nächstes">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M4 4.5v15a.8.8 0 0 0 1.2.7l10.3-7.5a.8.8 0 0 0 0-1.4L5.2 3.8A.8.8 0 0 0 4 4.5z" />
                                                <rect x="17" y="4" width="3" height="16" rx="1" />
                                            </svg>
                                        </button>
                </div>
                <label class="setting-row setting-inline">
                    <span class="setting-icon"
                          title="Lautstärke:
                          aria-label="Lautstärke">🔊</span>
                    <span class="setting-value">@Math.Round(Player.Volume * 100) %</span>
                    <input type="range" min="0" max="1" step="0.01"
                           title="Lautstärke: @Math.Round(Player.Volume * 100) Prozent"
                           value="@Player.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @oninput="OnVolumeChanged" />
                </label>
            </div>
        </section>
    }

    @if (libraryVisible)
    {
        <section class="library-dialog" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>Audiodateien (@FilteredLibrary.Count() von @libraryTracks.Count)</span>
                <button class="close-button" title="Schließen" @onclick="CloseLibrary">×</button>
            </div>
            @if (libraryLoading)
            {
                <div class="library-status">Audiodateien werden gelesen …</div>
            }
            else
            {
                <div class="library-table-wrapper">
                    <table class="library-table">
                        <thead>
                            <tr>
                                <th><input placeholder="Interpret" @bind="artistFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="Titel" @bind="titleFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="z.B. >3:00" @bind="durationFilter" @bind:event="oninput" /></th>
                            </tr>
                            <tr>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Artist)">Interpret@(SortIndicator(LibrarySortColumn.Artist))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Title)">Titel@(SortIndicator(LibrarySortColumn.Title))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Duration)">Dauer@(SortIndicator(LibrarySortColumn.Duration))</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredLibrary)
                            {
                                <tr @onclick="() => SelectLibraryTrackAsync(item)">
                                    <td>@item.Track.Artist</td>
                                    <td>@item.Track.Title</td>
                                    <td>@FormatTime(item.Duration.TotalSeconds)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (editorVisible)
    {
        <section class="library-dialog" style="--editor-cover-size: @(editorCoverSize)rem;" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>Playlist bearbeiten (@FilteredPlaylist.Count() von @Player.Tracks.Count)</span>
                <button class="close-button" title="Schließen" @onclick="CloseEditor">×</button>
            </div>
            <input class="editor-search" type="search" placeholder="Suchen …"
                   @bind="editorSearch" @bind:event="oninput" />
            <div class="library-table-wrapper">
                <table class="library-table editor-table">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Position)">Nr.@(EditorSortIndicator(EditorSortColumn.Position))</th>
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Artist)">Interpret@(EditorSortIndicator(EditorSortColumn.Artist))</th>
                            <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Title)">Titel@(EditorSortIndicator(EditorSortColumn.Title))</th>
                            <th>Cover</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (track, index) in FilteredPlaylist)
                        {
                            var details = GetEditorDetails(track);
                            <tr @key="track" class="@(index == Player.CurrentIndex ? "current-row" : null)">
                                <td class="editor-position" @onclick="() => BeginEditPosition(index)">
                                    @if (editingIndex == index)
                                    {
                                        <input type="number" min="1" max="@Player.Tracks.Count"
                                               @bind="editingValue" @bind:event="oninput"
                                               @onkeydown="OnPositionKeyDown" @onblur="CommitPosition"
                                               @onclick:stopPropagation="true" autofocus />
                                    }
                                    else
                                    {
                                        @(index + 1)
                                    }
                                </td>
                                <td class="editor-link" @onclick="() => ShowTrackInfo(track)">@track.Artist</td>
                                <td class="editor-link" @onclick="() => ShowTrackInfo(track)">@track.Title</td>
                                <td class="editor-cover-cell">
                                    <button class="editor-cover" title="Abspielen" aria-label="Abspielen"
                                            @onclick="() => PlayFromEditorAsync(index)">
                                        @if (details.Cover is not null)
                                        {
                                            <img src="@details.Cover" alt="" />
                                        }
                                        else
                                        {
                                            <span class="editor-cover-placeholder">♪</span>
                                        }
                                        <span class="editor-cover-play">
                                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                                <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                                            </svg>
                                        </span>
                                        @if (details.Duration is { } duration)
                                        {
                                            <span class="editor-cover-duration">@FormatTime(duration.TotalSeconds)</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (pendingTrack is not null)
    {
        <div class="insert-overlay" @onclick:stopPropagation="true">
            <section class="insert-dialog">
                <div class="control-dialog-header">
                    <span>„@pendingTrack.Title“ einfügen</span>
                    <button class="close-button" title="Abbrechen" @onclick="() => pendingTrack = null">×</button>
                </div>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.Start)">Am Anfang der Playlist</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.BeforeCurrent)">Vor dem aktuellen Lied</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.AfterCurrent)">Hinter dem aktuellen Lied</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.AfterCurrentAndPlay)">Hinter dem aktuellen Lied und sofort abspielen</button>
                <button @onclick="() => InsertPendingAsync(TrackInsertPosition.End)">Am Ende der Playlist</button>
            </section>
        </div>
    }

    @if (trackInfo is not null)
    {
        <div class="insert-overlay" @onclick="CloseTrackInfo" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>Details zum Lied</span>
                    <button class="close-button" title="Schließen" @onclick="CloseTrackInfo">×</button>
                </div>
                <dl class="info-list">
                    @foreach (var entry in trackInfo)
                    {
                        <dt>@entry.Key</dt>
                        <dd>
                            @entry.Value
                            @if (entry.Key == "Tag-Typen")
                            {
                                <button class="info-button info-inline" title="Inhalt der Tags" aria-label="Inhalt der Tags"
                                        @onclick="ShowRawTags">i</button>
                            }
                            @if (entry.Key == "Cover-Bilder")
                            {
                                <button class="info-button info-inline" title="Cover-Bilder anzeigen" aria-label="Cover-Bilder anzeigen"
                                        @onclick="ShowPictures">i</button>
                            }
                        </dd>
                    }
                </dl>
            </section>
        </div>
    }

    @if (rawTags is not null)
    {
        <div class="insert-overlay" @onclick="CloseRawTags" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>Inhalt der Tags</span>
                    <button class="close-button" title="Schließen" @onclick="CloseRawTags">×</button>
                </div>
                <dl class="info-list">
                    @if (rawTags.Count == 0)
                    {
                        <dd>Keine Tags vorhanden.</dd>
                    }
                    @foreach (var entry in rawTags)
                    {
                        <dt>@entry.Key</dt>
                        <dd>@entry.Value</dd>
                    }
                </dl>
            </section>
        </div>
    }
    @if (pictures is not null)
    {
        <div class="insert-overlay" @onclick="ClosePictures" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>Cover-Bilder</span>
                    <button class="close-button" title="Schließen" @onclick="ClosePictures">×</button>
                </div>
                <div class="picture-list">
                    @if (pictures.Count == 0)
                    {
                        <span>Keine Cover-Bilder vorhanden.</span>
                    }
                    @foreach (var picture in pictures)
                    {
                        <figure>
                            <img src="@picture.Value" alt="@picture.Key" />
                            <figcaption>@picture.Key</figcaption>
                        </figure>
                    }
                </div>
            </section>
        </div>
    }
    @if (optionsVisible)
    {
        <div class="insert-overlay" @onclick="CloseOptions" @onclick:stopPropagation="true">
            <section class="insert-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>Einstellungen</span>
                    <button class="close-button" title="Schließen" @onclick="CloseOptions">×</button>
                </div>
                @if (!quitConfirmVisible)
                {
                    <label class="setting-row">
                        <span>Überblendung</span>
                        <input type="range" min="0" max="5" step="0.1"
                               title="Dauer der Überblendung: @Player.CrossfadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) Sekunden"
                               value="@Player.CrossfadeSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="OnCrossfadeChanged" />
                        <span class="setting-value">@Player.CrossfadeSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) s</span>
                    </label>
                    <label class="setting-row">
                        <span>Cover-Größe</span>
                        <input type="range" min="3" max="12" step="1"
                               title="Größe der Cover in der Playlistbearbeitung: @editorCoverSize rem"
                               value="@editorCoverSize"
                               @oninput="OnEditorCoverSizeChanged" />
                        <span class="setting-value">@editorCoverSize rem</span>
                    </label>
                    <button @onclick="OpenAnimationsAsync">Animationen</button>
                    @if (Player.CanQuit)
                    {
                        <button @onclick="RequestQuit">CoverplayerMP beenden</button>
                    }
                    else if (Player.IsPlaylistModified)
                    {
                        <button @onclick="SaveOnlyAsync">Playlist speichern</button>
                    }
                }
                else
                {
                    <span>Die Playlist wurde verändert. Soll sie vor dem Beenden gespeichert werden?</span>
                    <button @onclick="() => QuitAsync(true)">Speichern und beenden</button>
                    <button @onclick="() => QuitAsync(false)">Ohne Speichern beenden</button>
                    <button @onclick="() => quitConfirmVisible = false">Abbrechen</button>
                }
            </section>
        </div>
    }
    @if (animationChoices is not null)
    {
        <div class="insert-overlay" @onclick="CloseAnimations" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>Animationen (@animationChoices.Count(a => a.Active) von @animationChoices.Count)</span>
                    <button class="close-button" title="Schließen" @onclick="CloseAnimations">×</button>
                </div>
                <div class="animation-toolbar">
                    <button @onclick="() => SetAllAnimations(true)">Alle</button>
                    <button @onclick="() => SetAllAnimations(false)">Keine</button>
                </div>
                <div class="animation-list">
                    @foreach (var group in animationChoices.GroupBy(a => a.Group))
                    {
                        <label class="animation-group">
                            <input type="checkbox" checked="@group.All(a => a.Active)"
                                   @onchange="e => SetGroup(group.Key, e.Value is true)" />
                            @group.Key
                        </label>
                        @foreach (var choice in group)
                        {
                            <label class="animation-item">
                                <input type="checkbox" @bind="choice.Active" />
                                @choice.Label
                            </label>
                        }
                    }
                </div>
                <div class="animation-toolbar">
                    <button class="play-button" @onclick="SaveAnimationsAsync">Übernehmen</button>
                    <button @onclick="CloseAnimations">Abbrechen</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private bool controlsVisible;
    private int editorCoverSize = 5;
    private string? coverUri;
    private string? coverSource;
    private ElementReference coverCanvas;
    private bool coverChanged;
    private double displayPosition;
    private double durationValue;
    private bool isSeeking;
    private bool disposed;
    private DotNetObjectReference<Home>? keyboardReference;

    protected override void OnInitialized()
    {
        Player.StateChanged += OnPlayerStateChanged;
        BackNavigation.Handler = HandleBack;
    }

    private IReadOnlyList<KeyValuePair<string, string>>? trackInfo;
    private string? infoSource;

    private void ShowTrackInfo() => ShowTrackInfo(Player.CurrentTrack);

    private void ShowTrackInfo(Track? track)
    {
        infoSource = track?.Source;
        trackInfo = TrackMetadata.Read(infoSource);
    }

    private void CloseTrackInfo() => trackInfo = null;

    private IReadOnlyList<KeyValuePair<string, string>>? rawTags;

    private void ShowRawTags() => rawTags = TrackMetadata.ReadRawTags(infoSource);

    private void CloseRawTags() => rawTags = null;

    private IReadOnlyList<KeyValuePair<string, string>>? pictures;

    private void ShowPictures() => pictures = TrackMetadata.ReadPictures(infoSource);

    private void ClosePictures() => pictures = null;

    private bool optionsVisible;
    private bool quitConfirmVisible;

    private void OpenOptions()
    {
        quitConfirmVisible = false;
        optionsVisible = true;
    }

    private void CloseOptions()
    {
        optionsVisible = false;
        quitConfirmVisible = false;
    }

    private void RequestQuit()
    {
        if (Player.IsPlaylistModified && Player.Tracks.Count > 0)
            quitConfirmVisible = true;
        else
            Player.Quit();
    }

    private async Task QuitAsync(bool save)
    {
        if (save && await Player.SavePlaylistAsync() is null)
        {
            CloseOptions();
            return;
        }

        Player.Quit();
    }

    private async Task SaveOnlyAsync()
    {
        await Player.SavePlaylistAsync();
        CloseOptions();
    }

    private sealed class AnimationChoice
    {
        public string Name { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Group { get; set; } = string.Empty;
        public bool Active { get; set; }
    }

    private List<AnimationChoice>? animationChoices;

    private async Task OpenAnimationsAsync()
    {
        try
        {
            animationChoices = (await Js.InvokeAsync<AnimationChoice[]>("coverTransition.getAnimations")).ToList();
        }
        catch (JSException)
        {
            animationChoices = null;
        }
    }

    private void CloseAnimations() => animationChoices = null;

    private void SetAllAnimations(bool value)
    {
        foreach (var choice in animationChoices ?? [])
            choice.Active = value;
    }

    private void SetGroup(string group, bool value)
    {
        foreach (var choice in animationChoices?.Where(a => a.Group == group) ?? [])
            choice.Active = value;
    }

    private async Task SaveAnimationsAsync()
    {
        if (animationChoices is null)
            return;

        var names = animationChoices.Where(a => a.Active).Select(a => a.Name).ToArray();
        await Js.InvokeVoidAsync("coverTransition.setActiveAnimations", (object)names);
        animationChoices = null;
    }

    private bool HandleBack()
    {
        if (animationChoices is not null)
        {
            _ = InvokeAsync(() => { animationChoices = null; StateHasChanged(); });
            return true;
        }
        if (optionsVisible)
        {
            _ = InvokeAsync(() => { CloseOptions(); StateHasChanged(); });
            return true;
        }
        if (pictures is not null)
        {
            _ = InvokeAsync(() => { pictures = null; StateHasChanged(); });
            return true;
        }
        if (rawTags is not null)
        {
            _ = InvokeAsync(() => { rawTags = null; StateHasChanged(); });
            return true;
        }
        if (trackInfo is not null)
        {
            _ = InvokeAsync(() => { trackInfo = null; StateHasChanged(); });
            return true;
        }
        if (editorVisible)
        {
            _ = InvokeAsync(() => { CloseEditor(); StateHasChanged(); });
            return true;
        }

        if (pendingTrack is null && !libraryVisible)
            return false;

        _ = InvokeAsync(() =>
        {
            if (pendingTrack is not null)
                pendingTrack = null;
            else
                libraryVisible = false;
            StateHasChanged();
        });
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (coverChanged && !disposed)
        {
            coverChanged = false;
            var duration = (int)Math.Round(Math.Max(0.6, Player.CrossfadeSeconds) * 1000);
            try
            {
                await Js.InvokeVoidAsync("coverTransition.show", coverCanvas, coverUri, duration);
            }
            catch (JSException)
            {
            }
        }

        if (!firstRender)
            return;

        await LoadSettingsAsync();

        keyboardReference
        await Js.InvokeVoidAsync("coverPlayerKeyboard.register", keyboardReference);
    }

    private const string CrossfadeKey = "coverPlayer.crossfadeSeconds";
    private const string EditorCoverSizeKey = "coverPlayer.editorCoverSize";

    private async Task LoadSettingsAsync()
    {
        try
        {
            var crossfade = await Js.InvokeAsync<string?>("localStorage.getItem", CrossfadeKey);
            if (double.TryParse(crossfade, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var seconds))
                Player.CrossfadeSeconds = Math.Clamp(seconds, 0, 5);

            var coverSize = await Js.InvokeAsync<string?>("localStorage.getItem", EditorCoverSizeKey);
            if (int.TryParse(coverSize, out var size))
                editorCoverSize = Math.Clamp(size, 3, 12);

            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task SaveSettingAsync(string key, string value)
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", key, value);
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public Task HandleKeyboardShortcut
    {
        "n" => NextAsync(),
        "p" => PreviousAsync(),
        "+" => ChangeVolumeAsync(.05),
        "-" => ChangeVolumeAsync(-.05),
        " " => TogglePauseAsync(),
        _ => Task.CompletedTask
    };

    private void OnPlayerStateChanged(object? sender, EventArgs e)
    {
        if (disposed)
            return;

        if (!isSeeking)
            displayPosition = Player.Position;

        durationValue = Math.Max(0.1, Player.Duration);
        var currentCoverSource = Player.CurrentTrack?.CoverSource;
        if (!string.Equals(coverSource, currentCoverSource, StringComparison.Ordinal))
        {
            coverSource = currentCoverSource;
            coverUri = currentCoverSource is not null ? CoverImage.ToDataUri(currentCoverSource) : null;
            coverChanged = true;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private (double X, double Y, DateTime Time)? swipeStart;
    private bool suppressClick;

    private void OnSwipeStart(PointerEventArgs e)
    {
        suppressClick = false;
        swipeStart = (e.ClientX, e.ClientY, DateTime.UtcNow);
    }

    private async Task OnSwipeEndAsync(PointerEventArgs e)
    {
        if (swipeStart is not { } start)
            return;
        swipeStart = null;

        var dx = e.ClientX - start.X;
        var dy = e.ClientY - start.Y;
        if (Math.Abs(dx) < 60 || Math.Abs(dx) < Math.Abs(dy) * 1.5 ||
            DateTime.UtcNow - start.Time > TimeSpan.FromMilliseconds(800) ||
            Player.Tracks.Count == 0)
            return;

        suppressClick = true;
        if (dx > 0)
            await NextAsync();
        else
            await PreviousAsync();
    }

    private void ShowControls()
    {
        if (suppressClick)
        {
            suppressClick = false;
            return;
        }

        controlsVisible = true;
    }

    private void HideControls()
    {
        controlsVisible = false;
    }

    private Task OpenPlaylistAsync() => Player.OpenPlaylistAsync();

    private sealed record EditorDetails(string? Cover, TimeSpan? Duration);

    private enum EditorSortColumn { Position, Artist, Title }

    private bool editorVisible;
    private string editorSearch = string.Empty;
    private EditorSortColumn editorSortColumn = EditorSortColumn.Position;
    private bool editorSortDescending;
    private int? editingIndex;
    private string editingValue = string.Empty;
    private readonly Dictionary<string, EditorDetails> editorDetails = new(StringComparer.Ordinal);
    private readonly HashSet<string> editorDetailsLoading = new(StringComparer.Ordinal);
    private static readonly EditorDetails EmptyDetails = new(null, null);

    private void OpenEditor()
    {
        editorVisible = true;
        editingIndex = null;
    }

    private void CloseEditor()
    {
        editorVisible = false;
        editingIndex = null;
    }

    private void EditorSortBy(EditorSortColumn column)
    {
        if (editorSortColumn == column)
        {
            editorSortDescending = !editorSortDescending;
        }
        else
        {
            editorSortColumn = column;
            editorSortDescending = false;
        }
    }

    private string EditorSortIndicator(EditorSortColumn column) =>
        editorSortColumn != column ? string.Empty : editorSortDescending ? " ▼" : " ▲";

    private IEnumerable<(Track Track, int Index)> FilteredPlaylist
    {
        get
        {
            var search = editorSearch.Trim();
            var items = Player.Tracks.Select((t, i) => (Track: t, Index: i))
                .Where(x => search.Length == 0 ||
                            x.Track.Artist.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                            x.Track.Title.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                            (x.Index + 1).ToString() == search);
            var comparer = StringComparer.CurrentCultureIgnoreCase;
            return editorSortColumn switch
            {
                EditorSortColumn.Artist => editorSortDescending
                    ? items.OrderByDescending(x => x.Track.Artist, comparer).ThenBy(x => x.Track.Title, comparer)
                    : items.OrderBy(x => x.Track.Artist, comparer).ThenBy(x => x.Track.Title, comparer),
                EditorSortColumn.Title => editorSortDescending
                    ? items.OrderByDescending(x => x.Track.Title, comparer).ThenBy(x => x.Track.Artist, comparer)
                    : items.OrderBy(x => x.Track.Title, comparer).ThenBy(x => x.Track.Artist, comparer),
                _ => editorSortDescending ? items.OrderByDescending(x => x.Index) : items
            };
        }
    }

    private EditorDetails GetEditorDetails(Track track)
    {
        if (editorDetails.TryGetValue(track.Source, out var details))
            return details;

        if (editorDetailsLoading.Add(track.Source))
            _ = LoadEditorDetailsAsync(track);
        return EmptyDetails;
    }

    private async Task LoadEditorDetailsAsync(Track track)
    {
        var details = await Task.Run(() =>
        {
            string? cover = null;
            TimeSpan? duration = null;
            try
            {
                cover = CoverImage.ToDataUri(track.CoverSource ?? track.Source, 160);
            }
            catch (Exception)
            {
            }
            try
            {
                if (File.Exists(track.Source))
                {
                    using var file = TagLib.File.Create(track.Source);
                    if (file.Properties is { } props && props.Duration > TimeSpan.Zero)
                        duration = props.Duration;
                }
            }
            catch (Exception)
            {
            }
            return new EditorDetails(cover, duration);
        });

        if (disposed)
            return;
        await InvokeAsync(() =>
        {
            editorDetails[track.Source] = details;
            editorDetailsLoading.Remove(track.Source);
            StateHasChanged();
        });
    }

    private async Task PlayFromEditorAsync(int index)
    {
        editingIndex = null;
        await Player.PlayWithCrossfadeAsync(index);
    }

    private void BeginEditPosition(int index)
    {
        if (editingIndex == index)
            return;
        editingIndex = index;
        editingValue = (index + 1).ToString();
    }

    private void OnPositionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            CommitPosition();
        else if (e.Key == "Escape")
            editingIndex = null;
    }

    private void CommitPosition()
    {
        if (editingIndex is not { } from)
            return;
        editingIndex = null;
        if (int.TryParse(editingValue.Trim(), out var position))
            Player.MoveTrack(from, Math.Clamp(position, 1, Player.Tracks.Count) - 1);
    }

    private bool libraryVisible;
    private bool libraryLoading;
    private IReadOnlyList<LibraryTrack> libraryTracks = [];
    private string artistFilter = string.Empty;
    private string titleFilter = string.Empty;
    private string durationFilter = string.Empty;
    private Track? pendingTrack;

    private async Task OpenLibraryAsync()
    {
        libraryVisible = true;
        libraryLoading = true;
        StateHasChanged();
        try
        {
            libraryTracks = (await Player.GetLibraryTracksAsync())
                .OrderBy(t => t.Track.Artist, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(t => t.Track.Title, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        finally
        {
            libraryLoading = false;
        }
    }

    private void CloseLibrary()
    {
        libraryVisible = false;
        pendingTrack = null;
    }

    private enum LibrarySortColumn { Artist, Title, Duration }

    private LibrarySortColumn sortColumn = LibrarySortColumn.Artist;
    private bool sortDescending;

    private void SortBy(LibrarySortColumn column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private string SortIndicator(LibrarySortColumn column) =>
        sortColumn != column ? string.Empty : sortDescending ? " ▼" : " ▲";

    private IEnumerable<LibraryTrack> FilteredLibrary => Sort(libraryTracks.Where(t =>
        t.Track.Artist.Contains(artistFilter.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
        t.Track.Title.Contains(titleFilter.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
        MatchesDuration(t.Duration)));

    private IEnumerable<LibraryTrack> Sort(IEnumerable<LibraryTrack> items)
    {
        var comparer = StringComparer.CurrentCultureIgnoreCase;
        IOrderedEnumerable<LibraryTrack> ordered = sortColumn switch
        {
            LibrarySortColumn.Title => sortDescending
                ? items.OrderByDescending(t => t.Track.Title, comparer)
                : items.OrderBy(t => t.Track.Title, comparer),
            LibrarySortColumn.Duration => sortDescending
                ? items.OrderByDescending(t => t.Duration)
                : items.OrderBy(t => t.Duration),
            _ => sortDescending
                ? items.OrderByDescending(t => t.Track.Artist, comparer)
                : items.OrderBy(t => t.Track.Artist, comparer)
        };

        return sortColumn == LibrarySortColumn.Artist
            ? ordered.ThenBy(t => t.Track.Title, comparer)
            : ordered.ThenBy(t => t.Track.Artist, comparer);
    }

    private bool MatchesDuration(TimeSpan duration)
    {
        var filter = durationFilter.Trim();
        if (filter.Length == 0)
            return true;

        var op = filter[0];
        if (op is '<' or '>')
        {
            var value = filter[1..].Trim();
            if (value.Length == 0)
                return true;
            if (!TryParseDuration(value, out var limit))
                return false;
            return op == '>' ? duration > limit : duration < limit;
        }

        return FormatTime(duration.TotalSeconds).Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryParseDuration(string value, out TimeSpan result)
    {
        result = TimeSpan.Zero;
        var parts = value.Split(':');
        if (parts.Length > 3)
            return false;

        var seconds = 0d;
        foreach (var part in parts)
        {
            if (!double.TryParse(part.Replace(',', '.'),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var number))
                return false;
            seconds = seconds * 60 + number;
        }

        result = TimeSpan.FromSeconds(seconds);
        return true;
    }

    private async Task SelectLibraryTrackAsync(LibraryTrack item)
    {
        if (Player.Tracks.Count == 0)
        {
            await Player.InsertTrackAsync(item.Track, TrackInsertPosition.End);
            return;
        }

        pendingTrack = item.Track;
    }

    private async Task InsertPendingAsync(TrackInsertPosition position)
    {
        var track = pendingTrack;
        pendingTrack = null;
        if (track is not null)
            await Player.InsertTrackAsync(track, position);
    }
    private Task PreviousAsync() => Player.PreviousAsync();
    private Task NextAsync() => Player.NextAsync();
    private Task RestartAsync() => Player.RestartAsync();

    private Task TogglePauseAsync() =>
        Player.IsPlaying ? Player.PauseAsync() : Player.PlayAsync(Player.CurrentIndex);

    private Task ChangeVolumeAsync(double delta)
    {
        Player.Volume = Math.Clamp(Player.Volume + delta, 0, 1);
        return Task.CompletedTask;
    }

    private void BeginSeeking() => isSeeking = true;

    private async Task OnSeekChanged(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var value))
            return;

        displayPosition = Math.Clamp(value, 0, Math.Max(0, Player.Duration));
        await Player.SeekAsync(displayPosition);
    }

    private void EndSeeking()
    {
        isSeeking = false;
        displayPosition = Player.Position;
    }

    private async Task OnCrossfadeChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var value))
        {
            Player.CrossfadeSeconds = Math.Clamp(value, 0, 5);
            await SaveSettingAsync(CrossfadeKey,
                Player.CrossfadeSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
    }

    private async Task OnEditorCoverSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            editorCoverSize = Math.Clamp(value, 3, 12);
            await SaveSettingAsync(EditorCoverSizeKey, editorCoverSize.ToString());
        }
    }

    private void OnVolumeChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var value))
            Player.Volume = Math.Clamp(value, 0, 1);
    }

    private static string FormatTime(double seconds) =>
        TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Player.StateChanged -= OnPlayerStateChanged;
        BackNavigation.Handler = null;
        if (keyboardReference is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("coverPlayerKeyboard.unregister");
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            keyboardReference.Dispose();
        }
    }
}
