    private void OnPlayerStateChanged(object? sender, EventArgs e)
    {
        if (disposed)
            return;

        var currentErrorMessage = Player.ErrorMessage;
        var currentNeedsMusicFolder = Player.NeedsMusicFolder;
        var currentMissingFileCount = Player.MissingFiles.Count;
        if (!string.Equals(lastPlayerErrorMessage, currentErrorMessage, StringComparison.Ordinal) ||
            lastNeedsMusicFolder != currentNeedsMusicFolder ||
            lastMissingFileCount != currentMissingFileCount)
            playerErrorDismissed = false;
        lastPlayerErrorMessage = currentErrorMessage;
        lastNeedsMusicFolder = currentNeedsMusicFolder;
        lastMissingFileCount = currentMissingFileCount;

        if (!isSeeking)
            displayPosition = Player.Position;

        durationValue = Math.Max(0.1, Player.Duration);
        var currentCoverSource = Player.CurrentTrack?.CoverSource;
        if (!string.Equals(coverSource, currentCoverSource, StringComparison.Ordinal))
        {
            coverSource = currentCoverSource;
            coverUri = currentCoverSource is not null ? CoverImage.ToDataUri(currentCoverSource) : null;
            coverChanged = true;
        }

        var currentTrack = Player.CurrentTrack;
        var trackKey = currentTrack is null ? null : $"{currentTrack.Artist}\u001f{currentTrack.Title}\u001f{currentTrack.Source}";
        if (!string.Equals(youTubeTrackKey, trackKey, StringComparison.Ordinal))
        {
            youTubeTrackKey = trackKey;
            _ = SearchYouTubeAsync(currentTrack);
        }

        _ = RenderSafeAsync();
    }

    private async Task SearchYouTubeAsync(Track? track)
    {
        youTubeAvailable = false;
        youTubeResults = [];
        selectedYouTubeVideo = null;
        youTubeChooserVisible = false;
        youTubeEmbedFailed = false;
        youTubeEmbedChanged = false;
        youTubeSearchUrl = track is null ? null : YouTubeSearchService.SearchUrl(track.Artist, track.Title);
        if (track is null)
            return;

        youTubeSearching = true;
        await RenderSafeAsync();
        try
        {
            if (youTubeSearchMode == YouTubeSearchMode.SearchPage)
            {
                youTubeAvailable = true;
                return;
            }

            youTubeResults = await YouTubeSearcher.SearchAsync(track.Artist, track.Title, youTubeSearchMode, youTubeApiKey);
            youTubeAvailable = youTubeResults.Count > 0;
            if (youTubeResults.Count == 1)
            {
                selectedYouTubeVideo = youTubeResults[0];
                youTubeEmbedChanged = true;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            youTubeResults = [];
            youTubeAvailable = false;
        }
        finally
        {
            youTubeSearching = false;
            await RenderSafeAsync();
        }
    }

    private void StartYouTubeSearchForCurrentTrack()
    {
        var track = Player.CurrentTrack;
        var trackKey = track is null ? null : $"{track.Artist}\u001f{track.Title}\u001f{track.Source}";
        youTubeTrackKey = trackKey;
        _ = SearchYouTubeAsync(track);
    }

