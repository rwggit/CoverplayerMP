    private string ChangeLabel => Text.Code switch
    {
        var c when c.StartsWith("de", StringComparison.OrdinalIgnoreCase) => "Anderes Cover suchen",
        var c when c.StartsWith("fr", StringComparison.OrdinalIgnoreCase) => "Chercher une autre pochette",
        _ => "Find another cover"
    };

    private string CoverSearchWaitingLabel => Text.Code switch
    {
        var c when c.StartsWith("de", StringComparison.OrdinalIgnoreCase) => "Warte auf Cover.jpg im Downloadordner …",
        var c when c.StartsWith("fr", StringComparison.OrdinalIgnoreCase) => "En attente de Cover.jpg dans Téléchargements …",
        _ => "Waiting for Cover.jpg in the downloads folder …"
    };

    private async Task StartCoverSearchAsync()
    {
        if (Player.CurrentTrack is not { } track || coverSearching)
            return;

        infoSource = track.Source;
        pictures ??= [];
        newCoverBytes = null;
        newCover = null;
        coverSearching = true;

        coverSearchCancellation?.Cancel();
        var cancellation = coverSearchCancellation = new CancellationTokenSource();
        try
        {
            var url = CoverSearcher.Begin(track.Artist, track.Title);
            await Js.InvokeVoidAsync("open", url, "_blank");
            StateHasChanged();

            newCoverBytes = await CoverSearcher.WaitForNewCoverAsync(TimeSpan.FromMinutes(5), cancellation.Token);
            newCover = newCoverBytes is null
                ? null
                : $"data:image/jpeg;base64,{Convert.ToBase64String(newCoverBytes)}";
        }
        catch (Exception ex) when (disposed || ex is OperationCanceledException || IsShutdownException(ex))
        {
        }
        finally
        {
            coverSearching = false;
        }

        if (!disposed)
            StateHasChanged();
    }

    private async Task ApplyCover()
    {
        if (newCoverBytes is null || Player.CurrentTrack is not { } track)
            return;

        var bytes = newCoverBytes;
        try
        {
            Task Write()
            {
                CoverSearch.Apply(track.Source, bytes);
                return Task.CompletedTask;
            }

            // Läuft die Datei gerade, wird sie kurz freigegeben und danach nahtlos fortgesetzt.
            if (Player is ICoverFileAccess access)
                await access.RunWithReleasedFileAsync(track.Source, Write);
            else
                await Write();

            coverUri = CoverImage.ToDataUri(track.CoverSource ?? track.Source);
            coverChanged = true;
            newCoverBytes = null;
            newCover = null;
            pictures = TrackMetadata.ReadPictures(infoSource);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or TagLib.CorruptFileException
                                       or TagLib.UnsupportedFormatException)
        {
            newCover = null;
        }
    }

