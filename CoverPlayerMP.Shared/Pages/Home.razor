                                    <line x1="3" y1="9" x2="21" y2="9" />
                                    <line x1="3" y1="14" x2="21" y2="14" />
                                    <line x1="3" y1="19" x2="21" y2="19" />
                                </svg>
                            </button>
                            <button type="button" class="layout-button @(playlistLayout == PlaylistLayout.Left ? "active" : null)"
                                    title="@Text.PlaylistLayoutLeft" aria-label="@Text.PlaylistLayoutLeft"
                                    @onclick="() => SetPlaylistLayoutAsync(PlaylistLayout.Left)">
                                <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                                    <rect x="3" y="4" width="7" height="16" rx="1.2" />
                                    <line x1="13" y1="8" x2="21" y2="8" />
                                    <line x1="13" y1="16" x2="18" y2="16" />
                                </svg>
                            </button>
                            <button type="button" class="layout-button @(playlistLayout == PlaylistLayout.Right ? "active" : null)"
                                    title="@Text.PlaylistLayoutRight" aria-label="@Text.PlaylistLayoutRight"
                                    @onclick="() => SetPlaylistLayoutAsync(PlaylistLayout.Right)">
                                <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                                    <rect x="14" y="4" width="7" height="16" rx="1.2" />
                                    <line x1="3" y1="8" x2="11" y2="8" />
                                    <line x1="6" y1="16" x2="11" y2="16" />
                                </svg>
                            </button>
                        </div>
                    </label>
                    <label class="setting-row">
                        <span>@Text.LanguageLabel</span>
                        <select value="@Text.Language" @onchange="OnLanguageChanged">
                            <option value="@AppLanguage.Auto">@Text.LanguageAuto</option>
                            <option value="@AppLanguage.German">Deutsch</option>
                            <option value="@AppLanguage.English">English</option>
                            <option value="@AppLanguage.French">Français</option>
                        </select>
                    </label>
                    <label class="setting-row">
                        <span>@Text.YouTubeSearchMethod</span>
                        <select value="@youTubeSearchMode" @onchange="OnYouTubeSearchModeChanged">
                            <option value="@YouTubeSearchMode.DataApi">@Text.YouTubeDataApi</option>
                            <option value="@YouTubeSearchMode.PublicSearch">@Text.YouTubePublicSearch</option>
                            <option value="@YouTubeSearchMode.SearchPage">@Text.YouTubeSearchPage</option>
                        </select>
                        <small class="setting-hint">@Text.YouTubeSearchMethodHint</small>
                    </label>
                    <label class="setting-row">
                        <span>@Text.AcoustIdApiKey</span>
                        <input type="password" value="@acoustIdApiKey" @oninput="OnAcoustIdApiKeyChanged" autocomplete="off" />
                        <small class="setting-hint">@Text.AcoustIdApiKeyHint<a href="https://acoustid.org/new-application" target="_blank" rel="noopener noreferrer">acoustid.org/new-application</a></small>
                    </label>
                    @if (youTubeSearchMode == YouTubeSearchMode.DataApi)
                    {
                        <label class="setting-row">
                            <span>@Text.YouTubeApiKey</span>
                            <input type="password" value="@youTubeApiKey" @oninput="OnYouTubeApiKeyChanged" autocomplete="off" />
                            <small class="setting-hint">@Text.YouTubeApiKeyHint</small>
                        </label>
