    private async Task LoadMusicBrainzAsync()
    {
        if (Player.CurrentTrack is not { } track || string.IsNullOrWhiteSpace(infoSource))
            return;

        musicBrainzBusy = true;
        musicBrainzStatus = Text.MusicBrainzSearching;
        musicBrainzError = null;
        musicBrainzMetadata = null;
        musicBrainzCoverDataUri = null;
        musicBrainzCoverBytes = null;
        musicBrainzCoverSelected = false;
        selectedMusicBrainzFields.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            musicBrainzMetadata = await MusicBrainzSearcher.FindAsync(track.Artist, track.Title);
            if (musicBrainzMetadata is null)
            {
                musicBrainzError = Text.MusicBrainzNoMatch;
                return;
            }

            editableMetadata = TrackMetadata.ReadEditableValues(infoSource);
            currentCoverDataUri = CoverImage.ToDataUri(infoSource);
            currentCoverBytes = TrackMetadata.ReadFirstPictureBytes(infoSource);
            if (musicBrainzMetadata.CoverUrl is not null)
            {
                musicBrainzCoverBytes = await MusicBrainzSearcher.DownloadCoverAsync(musicBrainzMetadata.CoverUrl);
                if (musicBrainzCoverBytes is { Length: > 0 })
                {
                    musicBrainzCoverDataUri = $"data:image/jpeg;base64,{Convert.ToBase64String(musicBrainzCoverBytes)}";
                    musicBrainzCoverSelected = currentCoverBytes is null || !currentCoverBytes.AsSpan().SequenceEqual(musicBrainzCoverBytes);
                }
            }
            foreach (var field in musicBrainzMetadata.Values.Keys)
            {
                if (!editableMetadata.TryGetValue(field, out var currentValue) ||
                    !string.Equals(currentValue, musicBrainzMetadata.Values[field], StringComparison.Ordinal))
                    selectedMusicBrainzFields.Add(field);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            musicBrainzError = Text.MusicBrainzError;
        }
        finally
        {
            musicBrainzBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAcoustIdAsync()
    {
        if (Player.CurrentTrack is not { } track || string.IsNullOrWhiteSpace(infoSource))
            return;

        musicBrainzBusy = true;
        musicBrainzStatus = Text.AcoustIdSearching;
        musicBrainzError = null;
        musicBrainzMetadata = null;
        musicBrainzCoverDataUri = null;
        musicBrainzCoverBytes = null;
        musicBrainzCoverSelected = false;
        selectedMusicBrainzFields.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            // SAF-Auswahl liefert unter Android normalerweise eine content://-URI. FFmpeg kann
            // diese URI nicht direkt öffnen; der Player materialisiert sie vorher im App-Cache.
            var localSource = await Player.ResolveLocalSourceAsync(track);
            if (!string.IsNullOrWhiteSpace(localSource))
                infoSource = localSource;

            var fingerprint = await MusicBrainzSearcher.CreateFingerprintAsync(infoSource);
            var match = (await MusicBrainzSearcher.FindAcoustIdMatchesAsync(fingerprint, acoustIdApiKey)).FirstOrDefault();
            musicBrainzMetadata = match is null
                ? null
                : await MusicBrainzSearcher.FindByRecordingIdAsync(match.RecordingId);
            if (musicBrainzMetadata is null)
            {
                musicBrainzError = Text.AcoustIdNoMatch;
                return;
            }

            editableMetadata = TrackMetadata.ReadEditableValues(infoSource);
            currentCoverDataUri = CoverImage.ToDataUri(infoSource);
            currentCoverBytes = TrackMetadata.ReadFirstPictureBytes(infoSource);
            if (musicBrainzMetadata.CoverUrl is not null)
            {
                musicBrainzCoverBytes = await MusicBrainzSearcher.DownloadCoverAsync(musicBrainzMetadata.CoverUrl);
                if (musicBrainzCoverBytes is { Length: > 0 })
                {
                    musicBrainzCoverDataUri = $"data:image/jpeg;base64,{Convert.ToBase64String(musicBrainzCoverBytes)}";
                    musicBrainzCoverSelected = currentCoverBytes is null || !currentCoverBytes.AsSpan().SequenceEqual(musicBrainzCoverBytes);
                }
            }
            foreach (var field in musicBrainzMetadata.Values.Keys)
            {
                if (!editableMetadata.TryGetValue(field, out var currentValue) ||
                    !string.Equals(currentValue, musicBrainzMetadata.Values[field], StringComparison.Ordinal))
                    selectedMusicBrainzFields.Add(field);
            }
        }
        catch (FingerprintCreationException ex)
        {
            var message = OperatingSystem.IsAndroid()
                ? Text.AcoustIdAndroidNativeError
                : Text.AcoustIdFingerprintError;
            var detail = string.Join(" → ", ExceptionMessages(ex));
            musicBrainzError = string.IsNullOrWhiteSpace(detail)
                ? message
                : $"{message} Details: {detail}";
        }
        catch (AcoustIdApiException ex) when (ex.IsApiKeyProblem)
        {
            musicBrainzError = Text.AcoustIdApiKeyError;
        }
        catch (AcoustIdApiException)
        {
            musicBrainzError = Text.AcoustIdApiError;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException or FileNotFoundException)
        {
            musicBrainzError = Text.AcoustIdError;
        }
        finally
        {
            musicBrainzBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static IEnumerable<string> ExceptionMessages(Exception exception)
    {
        for (var current = exception; current is not null; current = current.InnerException)
        {
            if (!string.IsNullOrWhiteSpace(current.Message))
                yield return current.Message;
        }
    }

    private void ToggleMusicBrainzField(MetadataField field, bool selected)
    {
        if (selected)
            selectedMusicBrainzFields.Add(field);
        else
            selectedMusicBrainzFields.Remove(field);
    }

    private async Task ApplyMusicBrainzAsync()
    {
        if (musicBrainzMetadata is null || string.IsNullOrWhiteSpace(infoSource))
            return;

        var values = musicBrainzMetadata.Values
            .Where(pair => selectedMusicBrainzFields.Contains(pair.Key))
            .ToDictionary(pair => pair.Key, pair => pair.Value);
        if (values.Count == 0 && !musicBrainzCoverSelected)
        {
            musicBrainzError = Text.NoChanges;
            return;
        }

        try
        {
            TrackMetadata.WriteEditableValues(infoSource, values);
            if (musicBrainzCoverSelected && musicBrainzCoverBytes is { Length: > 0 } && Player.CurrentTrack is { } track)
            {
                var localFile = LocalMetadataSource(track);
                if (localFile is not null && File.Exists(localFile))
                {
                    Task WriteCover()
                    {
                        CoverSearch.Apply(localFile, musicBrainzCoverBytes);
                        return Task.CompletedTask;
                    }

                    if (Player is ICoverFileAccess access)
                        await access.RunWithReleasedFileAsync(track.Source, WriteCover);
                    else
                        await WriteCover();
                    coverUri = CoverImage.ToDataUri(localFile);
                    coverChanged = true;
                }
            }
            editableMetadata = TrackMetadata.ReadEditableValues(infoSource);
            rawTags = TrackMetadata.ReadRawTags(infoSource, Text);
            musicBrainzMetadata = null;
            musicBrainzCoverDataUri = null;
            musicBrainzCoverBytes = null;
            musicBrainzCoverSelected = false;
            musicBrainzError = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or TagLib.CorruptFileException or InvalidOperationException)
        {
            musicBrainzError = ex.Message;
        }
    }

