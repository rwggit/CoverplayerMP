    private const double EditorPaneWidthMin = 180;
    private const double EditorPaneWidthMax = 640;
    private const double EditorPaneWidthDefault = 280;
    // Grober horizontaler "Chrome"-Abzug (Panel- und Karten-Padding), damit die Cover-Kante
    // nicht am Panelrand anstößt, wenn die Größe aus der Panelbreite abgeleitet wird.
    private const double SplitCoverHorizontalChromePx = 56;
    private double editorPaneWidth = EditorPaneWidthDefault;
    // Für die Bitmap-Decodierauflösung wird absichtlich nicht die live während des Ziehens
    // laufende editorPaneWidth verwendet, sondern ein nur bei Drag-Ende aktualisierter Wert:
    // Jede Breitenänderung würde sonst den Cache-Key aller sichtbaren Cover ändern und laufend
    // neue Decodier-Tasks auslösen (führte auf Android zu "App reagiert nicht"-Hängern).
    private double editorPaneWidthSettled = EditorPaneWidthDefault;
    private bool isDraggingPane;

    // Im Split-Modus (Playlist links/rechts neben dem Cover) richtet sich die Cover-Darstellungsgröße
    // automatisch nach der vom Anwender gezogenen Panelbreite; die CoverSize-Einstellung gilt dann nur
    // noch für die zentrierte Tabellen-/Kartenansicht.
    private double EditorCoverSizeRem => PlaylistSplitActive
        ? Math.Clamp((editorPaneWidth - SplitCoverHorizontalChromePx) / 16.0, 3, 24)
        : editorCoverSize;

    // Grundlage für die Bitmap-Pixelgröße: reagiert nicht auf jede Zwischenposition beim Ziehen,
    // sondern nur auf die zuletzt "fertig gezogene" Panelbreite.
    private double EditorCoverPixelSizeRem => PlaylistSplitActive
        ? Math.Clamp((editorPaneWidthSettled - SplitCoverHorizontalChromePx) / 16.0, 3, 24)
        : editorCoverSize;
    private double paneDragStartX;
    private double paneDragStartWidth;

    private void BeginPaneResize(PointerEventArgs e)
    {
        isDraggingPane = true;
        paneDragStartX = e.ClientX;
        paneDragStartWidth = editorPaneWidth;
    }

    private void OnPaneResizeMove(PointerEventArgs e)
    {
        if (!isDraggingPane)
            return;

        var delta = e.ClientX - paneDragStartX;
        // Beim linksbündigen Layout liegt das Panel links vom Resizer: Ziehen nach rechts vergrößert es.
        // Beim rechtsbündigen Layout liegt es rechts vom Resizer: Ziehen nach links vergrößert es.
        if (playlistLayout == PlaylistLayout.Right)
            delta = -delta;

        editorPaneWidth = Math.Clamp(paneDragStartWidth + delta, EditorPaneWidthMin, EditorPaneWidthMax);
    }

    private async Task EndPaneResize(PointerEventArgs e)
    {
        if (!isDraggingPane)
            return;

        isDraggingPane = false;
        editorPaneWidthSettled = editorPaneWidth;
        await SaveSettingAsync(EditorPaneWidthKey, editorPaneWidth.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

