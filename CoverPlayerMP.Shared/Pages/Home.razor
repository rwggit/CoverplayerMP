            ShowTrackInfo(track);
        }
    }

    private bool CanRemoveSelected => EffectiveIndices.Count > 0 && removingTrack is null;

    private string? removingTrack;

    private async Task RemoveSelectedTrackAsync()
    {
        var indices = EffectiveIndices;
        if (!editorVisible || libraryVisible || pendingTrack is not null || removingTrack is not null ||
            indices.Count == 0)
            return;

        editingIndex = null;
        if (indices.Count == 1)
        {
            var track = Player.Tracks[indices[0]];
            removingTrack = Text.RemovingOne(string.IsNullOrWhiteSpace(track.Title) ? Path.GetFileName(track.Source) : track.Title);
        }
        else
        {
            removingTrack = Text.RemovingMany(indices.Count);
        }
        StateHasChanged();
        try
        {
            foreach (var index in indices.OrderByDescending(i => i))
                await Player.RemoveTrackAsync(index);
        }
        finally
        {
            removingTrack = null;
            ClearSelection();
        }
        StateHasChanged();
    }

    private void EditorSortBy(EditorSortColumn column)
    {
        if (editorSortColumn == column)
        {
            editorSortDescending = !editorSortDescending;
        }
        else
        {
            editorSortColumn = column;
            editorSortDescending = false;
        }
    }

    private string EditorSortIndicator(EditorSortColumn column) =>
        editorSortColumn != column ? string.Empty : editorSortDescending ? " ▼" : " ▲";

    private IEnumerable<(Track Track, int Index)> FilteredPlaylist
    {
        get
        {
            var search = editorSearch.Trim();
            var items = Player.Tracks.Select((t, i) => (Track: t, Index: i))
                .Where(x => search.Length == 0 ||
                            x.Track.Artist.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                            x.Track.Title.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                            (x.Index + 1).ToString() == search);
            var comparer = StringComparer.CurrentCultureIgnoreCase;
            return editorSortColumn switch
            {
                EditorSortColumn.Artist => editorSortDescending
                    ? items.OrderByDescending(x => x.Track.Artist, comparer).ThenBy(x => x.Track.Title, comparer)
                    : items.OrderBy(x => x.Track.Artist, comparer).ThenBy(x => x.Track.Title, comparer),
                EditorSortColumn.Title => editorSortDescending
                    ? items.OrderByDescending(x => x.Track.Title, comparer).ThenBy(x => x.Track.Artist, comparer)
                    : items.OrderBy(x => x.Track.Title, comparer).ThenBy(x => x.Track.Artist, comparer),
                _ => editorSortDescending ? items.OrderByDescending(x => x.Index) : items
            };
        }
    }

    // Schlüssel enthält die CoverSource: Server-Titel haben zunächst eine URL (kein Cover). Sobald der Titel
    // heruntergeladen ist, zeigt CoverSource auf die lokale Datei, und das Cover wird neu geladen.
    // Die Pixelgröße ist Teil des Schlüssels, damit das Cover neu (und schärfer) geladen wird, sobald die
    // Cover-Größe in den Optionen verändert wird.
    private static string EditorDetailsKey(Track track, int pixelSize) =>
        track.Source + "|" + (track.CoverSource ?? string.Empty) + "|" + pixelSize;

    // Zielauflösung des Covers in Pixel: an die tatsächliche Darstellungsgröße (in rem, im Split-Modus aus
    // der Panelbreite abgeleitet) gekoppelt und mit einem Faktor für hochauflösende (Retina/HiDPI) Displays
    // versehen, damit das Cover nicht unscharf wirkt.
    private int EditorCoverPixelSize => Math.Clamp((int)Math.Round(EditorCoverPixelSizeRem * 16 * 3), 160, 1152);

    private EditorDetails GetEditorDetails(Track track)
    {
        var pixelSize = EditorCoverPixelSize;
        var key = EditorDetailsKey(track, pixelSize);
        if (editorDetails.TryGetValue(key, out var details))
            return details;

        if (editorDetailsLoading.Add(key))
            _ = LoadEditorDetailsAsync(track, key, pixelSize);
        return EmptyDetails;
    }

    private async Task LoadEditorDetailsAsync(Track track, string key, int pixelSize)
    {
        var details = await Task.Run(() =>
        {
            string? cover = null;
            TimeSpan? duration = null;
            try
            {
                cover = CoverImage.ToDataUri(track.CoverSource ?? track.Source, pixelSize);
            }
            catch (Exception)
            {
            }
            try
            {
                var audioFile = File.Exists(track.Source) ? track.Source
                    : track.CoverSource is { } local && File.Exists(local) ? local
                    : null;
                if (audioFile is not null)
                {
                    using var file = TagLib.File.Create(audioFile);
                    if (file.Properties is { } props && props.Duration > TimeSpan.Zero)
                        duration = props.Duration;
                }
            }
            catch (Exception)
            {
            }
            return new EditorDetails(cover, duration);
        });

        if (disposed)
            return;
        await InvokeAsync(() =>
        {
            editorDetails[key] = details;
            editorDetailsLoading.Remove(key);
            StateHasChanged();
        });
    }

