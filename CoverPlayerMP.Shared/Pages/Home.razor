    private async Task LoadSettingsAsync()
    {
        try
        {
            var crossfade = await Js.InvokeAsync<string?>("localStorage.getItem", CrossfadeKey);
            if (double.TryParse(crossfade, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var seconds))
                Player.CrossfadeSeconds = Math.Clamp(seconds, 0, 5);

            var maxPlaybackDuration = await Js.InvokeAsync<string?>("localStorage.getItem", MaxPlaybackDurationKey);
            if (double.TryParse(maxPlaybackDuration, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var parsedMaxPlaybackDuration))
                maxPlaybackSeconds = Math.Max(0, parsedMaxPlaybackDuration);
            Player.MaxPlaybackSeconds = maxPlaybackSeconds;

            var coverFade = await Js.InvokeAsync<string?>("localStorage.getItem", CoverFadeKey);
            if (double.TryParse(coverFade, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var fadeSeconds))
                coverFadeSeconds = Math.Clamp(fadeSeconds, 0, 5);

            var coverSize = await Js.InvokeAsync<string?>("localStorage.getItem", EditorCoverSizeKey);
            if (int.TryParse(coverSize, out var size))
                editorCoverSize = Math.Clamp(size, 3, 24);

            var subDialogTransparency = await Js.InvokeAsync<string?>("localStorage.getItem", SubDialogTransparencyKey);
            if (int.TryParse(subDialogTransparency, out var parsedSubDialogTransparency))
                subDialogTransparencyPercent = Math.Clamp(parsedSubDialogTransparency, 0, 100);

            var layout = await Js.InvokeAsync<string?>("localStorage.getItem", PlaylistLayoutKey);
            if (Enum.TryParse<PlaylistLayout>(layout, out var parsedLayout))
                playlistLayout = parsedLayout;

            var paneWidth = await Js.InvokeAsync<string?>("localStorage.getItem", EditorPaneWidthKey);
            if (double.TryParse(paneWidth, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var parsedPaneWidth))
            {
                editorPaneWidth = Math.Clamp(parsedPaneWidth, EditorPaneWidthMin, EditorPaneWidthMax);
                editorPaneWidthSettled = editorPaneWidth;
            }

            var language = await Js.InvokeAsync<string?>("localStorage.getItem", LanguageKey);
            if (Enum.TryParse<AppLanguage>(language, out var appLanguage))
                Text.Language = appLanguage;
            serverUrl = await Js.InvokeAsync<string?>("localStorage.getItem", ServerUrlKey) ?? serverUrl;
            serverUser = await Js.InvokeAsync<string?>("localStorage.getItem", ServerUserKey) ?? serverUser;
            var youTubeMode = await Js.InvokeAsync<string?>("localStorage.getItem", YouTubeSearchModeKey);
            if (Enum.TryParse<YouTubeSearchMode>(youTubeMode, out var parsedYouTubeMode))
                youTubeSearchMode = parsedYouTubeMode;
            youTubeApiKey = await Js.InvokeAsync<string?>("localStorage.getItem", YouTubeApiKeyKey) ?? youTubeApiKey;
            acoustIdApiKey = await Js.InvokeAsync<string?>("localStorage.getItem", AcoustIdApiKeyKey) ?? acoustIdApiKey;

            await Js.InvokeVoidAsync("document.documentElement.setAttribute", "lang", Text.Code);

            StateHasChanged();
        }
        catch (Exception ex) when (disposed || IsShutdownException(ex))
        {
        }
    }

