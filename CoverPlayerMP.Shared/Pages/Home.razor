    private async Task OnSubDialogTransparencyChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            subDialogTransparencyPercent = Math.Clamp(value, 0, 100);
            await SaveSettingAsync(SubDialogTransparencyKey, subDialogTransparencyPercent.ToString());
        }
