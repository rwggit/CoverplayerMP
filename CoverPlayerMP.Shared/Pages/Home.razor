                    }
                    @if (!setupTabActive)
                    {
                    <button @onclick="OpenAnimationsAsync">@Text.Animations</button>
                    @if (Player.SupportsRemotePlayback)
                    {
                        <button @onclick="OpenRemoteDevicesAsync">@Text.RemotePlayback</button>
                    }
                    @if (Player.CanQuit)
                    {
                        <button @onclick="RequestQuit">@Text.QuitApp</button>
                    }
                    else if (Player.IsPlaylistModified)
                    {
                        <button @onclick="SaveOnlyAsync">@Text.SavePlaylist</button>
                    }
                    }
                }
                else
                {
                    <span>@Text.SaveBeforeQuit</span>
                    <button @onclick="() => QuitAsync(true)">@Text.SaveAndQuit</button>
                    <button @onclick="() => QuitAsync(false)">@Text.QuitWithoutSaving</button>
                    <button @onclick="() => quitConfirmVisible = false">@Text.Cancel</button>
                }
            </section>
        </div>
    }
    @if (animationChoices is not null)
    {
        <div class="insert-overlay" style="@SubDialogOpacityVars" @onclick="CloseAnimations" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.Animations (@animationChoices.Count(a => a.Active) @Text.Of @animationChoices.Count)</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseAnimations">×</button>
                </div>
                <div class="animation-toolbar">
                    <button @onclick="() => SetAllAnimations(true)">@Text.All</button>
                    <button @onclick="() => SetAllAnimations(false)">@Text.None</button>
                </div>
                <div class="animation-list">
                    @foreach (var group in animationChoices.GroupBy(a => a.Group))
                    {
                        <label class="animation-group">
                            <input type="checkbox" checked="@group.All(a => a.Active)"
                                   @onchange="e => SetGroup(group.Key, e.Value is true)" />
                            @group.Key
                        </label>
                        @foreach (var choice in group)
                        {
                            <label class="animation-item">
                                <input type="checkbox" @bind="choice.Active" />
                                @choice.Label
                            </label>
                        }
                    }
                </div>
                <div class="animation-toolbar">
                    <button class="play-button" @onclick="SaveAnimationsAsync">@Text.Apply</button>
                    <button @onclick="CloseAnimations">@Text.Cancel</button>
                </div>
            </section>
        </div>
    }
    @if (remoteDialogVisible)
    {
        <div class="insert-overlay" style="@SubDialogOpacityVars" @onclick="CloseRemoteDialog" @onclick:stopPropagation="true">
            <section class="info-dialog" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.RemotePlayback</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseRemoteDialog">×</button>
                </div>
                <div class="remote-list">
                    <button class="remote-device @(Player.ActiveDevice is null ? "active" : null)" @onclick="() => SelectRemoteDeviceAsync(null)">
                        <span>@Text.RemoteThisDevice</span>
                    </button>
                    @if (remoteDevices is not null)
                    {
                        @foreach (var device in remoteDevices)
                        {
                            <button class="remote-device @(Player.ActiveDevice?.Id == device.Id ? "active" : null)" @onclick="() => SelectRemoteDeviceAsync(device)">
                                <span>@device.Name</span>
                                <span class="remote-connection">@device.Connection</span>
                            </button>
                        }
                        @if (remoteDevices.Count == 0)
                        {
                            <span>@Text.RemoteNoDevices</span>
                        }
                    }
                    else if (remoteSearching)
                    {
                        <span>@Text.RemoteSearching</span>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private bool controlsVisible;
    private IWindowControls? WindowControls => (IWindowControls?)Services.GetService(typeof(IWindowControls));
    private bool windowButtonsVisible;

    private void HideControlsForSubDialog() => controlsVisible = false;

    private void HideTrackInfoForSubDialog() => trackInfo = null;

    private bool editorHiddenForSubDialog;

    private void HideEditorForSubDialog() => editorHiddenForSubDialog = true;

    private void UpdateWindowButtons() => windowButtonsVisible = WindowControls?.IsFullScreen == true;

    private Task PickMusicFolderAsync() => Player.SelectMusicFolderAsync();

    private Task PickAudioFilesAsync() => Player.SelectAudioFilesAsync();

    private bool playerErrorDismissed;
    private string? lastPlayerErrorMessage;
    private bool lastNeedsMusicFolder;
    private int lastMissingFileCount;

    private bool ShowPlayerError =>
        !playerErrorDismissed &&
        (!string.IsNullOrWhiteSpace(Player.ErrorMessage) || Player.NeedsMusicFolder);

    private void DismissPlayerError() => playerErrorDismissed = true;

    private bool serverDialogVisible;
    private string serverUrl = string.Empty;
    private string serverUser = string.Empty;
    private string serverPassword = string.Empty;
    private bool serverTrustCertificate;

    private List<ServerEntry>? serverEntries;
    private string serverFolder = string.Empty;
    private bool serverBusy;
    private string? serverError;

    private string? ServerParentUrl
    {
        get
        {
            if (!Uri.TryCreate(serverFolder, UriKind.Absolute, out var folder) || folder.AbsolutePath.TrimEnd('/').Length == 0)
                return null;
            var path = folder.AbsolutePath.TrimEnd('/');
            return new Uri(folder, path[..(path.LastIndexOf('/') + 1)]).AbsoluteUri;
        }
    }

    private async Task ConnectServerAsync()
    {
        // Always reset browsing state before a new connection attempt so the dialog
        // visibly returns to loading/input mode and errors are shown in the same flow.
        serverEntries = null;
        serverFolder = string.Empty;

        await BrowseServerAsync(NormalizeServerUrl(serverUrl));

        if (serverEntries is not null)
        {
            await SaveSettingAsync(ServerUrlKey, serverUrl.Trim());
            await SaveSettingAsync(ServerUserKey, serverUser.Trim());
        }
    }

    private static string NormalizeServerUrl(string value)
    {
        var trimmed = value.Trim();
        return trimmed.Length == 0 || trimmed.Contains("://", StringComparison.Ordinal) ? trimmed : "https://" + trimmed;
    }

    private async Task BrowseServerAsync(string folderUrl)
    {
        serverBusy = true;
        serverError = null;
        try
        {
            var entries = await Player.ListServerFolderAsync(folderUrl, serverUser, serverPassword, serverTrustCertificate);
            serverEntries = entries.ToList();
            serverFolder = folderUrl.EndsWith('/') ? folderUrl : folderUrl + "/";
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException
                                       or UriFormatException or System.Xml.XmlException)
        {
            serverError = DescribeException(ex);
        }
        finally
        {
            serverBusy = false;
        }
    }

    private string DescribeException(Exception ex)
    {
        var messages = new List<string>();
        for (var current = ex; current is not null; current = current.InnerException)
            if (!messages.Contains(current.Message))
                messages.Add(current.Message);

        // Bei unbekanntem Host (z. B. Tippfehler in der Adresse) direkt ein gültiges Beispiel mitgeben.
        var isHostNotFound = ex.InnerException is System.Net.Sockets.SocketException
            { SocketErrorCode: System.Net.Sockets.SocketError.HostNotFound };
        if (isHostNotFound)
            messages.Add(Text.ServerAddressExampleHint);

        // Bei SSL-Fehlern auf die Option für selbstsignierte Zertifikate hinweisen, falls sie noch nicht aktiv ist.
        var isSslError = messages.Any(m => m.Contains("SSL connection could not be established", StringComparison.OrdinalIgnoreCase));
        if (isSslError && !serverTrustCertificate)
            messages.Add(Text.ServerTrustCertificateHint);

        return string.Join(" → ", messages);
    }

    private async Task OpenServerEntryAsync(ServerEntry entry)
    {
        if (entry.IsFolder)
        {
            await BrowseServerAsync(entry.Url);
            return;
        }

        serverDialogVisible = false;
        await Player.OpenServerPlaylistAsync(entry.Url, serverUser, serverPassword, serverTrustCertificate);
    }

