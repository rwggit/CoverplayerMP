    private async Task BeginLongPress(int index, PointerEventArgs e)
    {
        CancelLongPress();
        if (e.PointerType == "mouse" && e.Button != 0)
            return;

        var cancellation = new CancellationTokenSource();
        longPressCancellation = cancellation;
        longPressStart = (e.ClientX, e.ClientY);
        try
        {
            await Task.Delay(500, cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (ReferenceEquals(longPressCancellation, cancellation))
            {
                longPressCancellation = null;
                longPressStart = null;
            }
            cancellation.Dispose();
        }

        editingIndex = null;
        selectionMode = true;
        selectedIndices.Add(index);
        selectionAnchor = index;
        suppressRowClick = true;
    }

    private void MoveLongPress(PointerEventArgs e)
    {
        if (longPressStart is { } start &&
            Math.Abs(e.ClientX - start.X) + Math.Abs(e.ClientY - start.Y) > 10)
            CancelLongPress();
    }

    private void CancelLongPress()
    {
        longPressCancellation?.Cancel();
        longPressCancellation = null;
        longPressStart = null;
    }

