    private void SelectRow(int index, MouseEventArgs e)
    {
        if (suppressRowClick)
        {
            suppressRowClick = false;
            return;
        }

        if (selectionMode && !e.ShiftKey)
        {
            if (!selectedIndices.Remove(index))
                selectedIndices.Add(index);
            selectionAnchor = index;
            return;
        }

        if (e.ShiftKey && selectionAnchor is { } anchor)
        {
            var visible = FilteredPlaylist.Select(x => x.Index).ToList();
            var from = visible.IndexOf(anchor);
            var to = visible.IndexOf(index);
            if (from >= 0 && to >= 0)
            {
                if (!e.CtrlKey)
                    selectedIndices.Clear();
                foreach (var i in visible.GetRange(Math.Min(from, to), Math.Abs(to - from) + 1))
                    selectedIndices.Add(i);
                return;
            }
        }

        if (e.CtrlKey || e.MetaKey)
        {
            if (!selectedIndices.Remove(index))
                selectedIndices.Add(index);
        }
        else
        {
            selectedIndices.Clear();
            selectedIndices.Add(index);
        }
        selectionAnchor = index;
    }

    private string? EditorRowClass(int index) =>
        string.Join(' ', new[]
        {
            index == Player.CurrentIndex ? "current-row" : null,
            selectedIndices.Contains(index) ? "selected-row" : null,
            dragIndex is not null && index == dropIndex && !DraggedIndices.Contains(index) ? "drop-target" : null
        }.Where(c => c is not null)) is { Length: > 0 } css ? css : null;

    private int? dragIndex;
    private int? dropIndex;

    private IReadOnlyCollection<int> DraggedIndices =>
        dragIndex is { } drag ? selectedIndices.Contains(drag) ? selectedIndices : [drag] : [];

    private void BeginDrag(int index)
    {
        dragIndex = index;
        if (!selectedIndices.Contains(index))
        {
            selectedIndices.Clear();
            selectedIndices.Add(index);
            selectionAnchor = index;
        }
    }

    private void DropTrack(int target)
    {
        var moving = DraggedIndices.Where(i => i >= 0 && i < Player.Tracks.Count).OrderBy(i => i).ToList();
        EndDrag();
        if (moving.Count == 0 || moving.Contains(target))
            return;

        var targetInRest = target - moving.Count(i => i < target);
        var insertAt = moving[0] < target ? targetInRest + 1 : targetInRest;

        var count = Player.Tracks.Count;
        for (var k = 0; k < moving.Count; k++)
            Player.MoveTrack(moving[k] - k, count - 1);
        for (var k = 0; k < moving.Count; k++)
            Player.MoveTrack(count - moving.Count + k, insertAt + k);

        selectedIndices.Clear();
        for (var k = 0; k < moving.Count; k++)
            selectedIndices.Add(insertAt + k);
        selectionAnchor = insertAt;
    }

    private void EndDrag()
    {
        dragIndex = null;
        dropIndex = null;
    }

    private IReadOnlyList<int> EffectiveIndices =>
        selectedIndices.Where(i => i >= 0 && i < Player.Tracks.Count).ToList() is { Count: > 0 } selected ? selected
        : Player.CurrentIndex >= 0 && Player.CurrentIndex < Player.Tracks.Count ? [Player.CurrentIndex]
        : [];

    private Track? SelectedTrack => EffectiveIndices is { Count: > 0 } indices ? Player.Tracks[indices[0]] : null;

