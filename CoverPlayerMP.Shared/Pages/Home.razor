@page "/"
@implements IAsyncDisposable
@inject IPlaylistPlayer Player
@inject IJSRuntime Js
@inject AppText Text
@inject CoverSearch CoverSearcher
@inject YouTubeSearchService YouTubeSearcher
@inject MusicBrainzService MusicBrainzSearcher
@inject IServiceProvider Services

<PageTitle>CoverPlayerMP</PageTitle>

<div class="player-shell @(PlaylistSplitActive ? (playlistLayout == PlaylistLayout.Left ? "player-shell-split-left" : "player-shell-split-right") : null)"
     style="@(PlaylistSplitActive ? $"--editor-pane-width: {editorPaneWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" : null)"
     >
    @if (WindowControls is { } windowControls)
    {
        <div class="window-hotspot" @onmouseenter="UpdateWindowButtons">
            @if (windowButtonsVisible)
            {
            <div class="window-buttons">
                <button title="Restore" aria-label="Restore" @onclick="RestoreWindow" @onclick:stopPropagation="true">&#x2750;</button>
                <button class="window-close" title="Close" aria-label="Close" @onclick="windowControls.Close" @onclick:stopPropagation="true">&times;</button>
            </div>
            }
        </div>
    }
    @if (ShowPlayerError)
    {
        <div class="player-error" role="alert" @onclick:stopPropagation="true">
            <div class="player-error-header">
                <div>@Player.ErrorMessage</div>
                <button class="close-button" title="@Text.Close" aria-label="@Text.Close"
                        @onclick="DismissPlayerError" @onclick:stopPropagation="true">&times;</button>
            </div>
            @if (Player.NeedsMusicFolder)
            {
                <select class="missing-files" size="5" aria-label="@Text.MissingFilesLabel" title="@Text.MissingFilesLabel">
                                    @foreach (var missing in Player.MissingFiles)
                                    {
                                        <option>@missing</option>
                                    }
                                </select>
                                <div class="player-error-actions">
                                <button @onclick="PickMusicFolderAsync" @onclick:stopPropagation="true">@Text.SelectMusicFolder</button>
                                <button @onclick="PickAudioFilesAsync" @onclick:stopPropagation="true">@Text.SelectAudioFiles</button>
                                </div>
            }
        </div>
    }
    @if (serverDialogVisible)
    {
        <div class="insert-overlay" style="@SubDialogOpacityVars" @onclick:stopPropagation="true">
            <section class="insert-dialog">
                <div class="control-dialog-header">
                    <span>@Text.ServerDialogTitle</span>
                    <button class="close-button" title="@Text.Close" @onclick="() => serverDialogVisible = false">&times;</button>
                </div>
                @if (serverEntries is null)
                {
                    <input placeholder="@Text.ServerUrl" @bind="serverUrl" @bind:event="oninput" />
                    <input placeholder="@Text.ServerUser" @bind="serverUser" @bind:event="oninput" />
                    <input type="password" placeholder="@Text.ServerPassword" @bind="serverPassword" @bind:event="oninput" />
                    <small class="setting-hint">@Text.ServerHint</small>
                    <label class="setting-hint"><input type="checkbox" @bind="serverTrustCertificate" /> @Text.ServerTrustCertificate</label>
                    @if (serverError is not null)
                    {
                        <strong class="server-error" role="alert">@serverError</strong>
                    }
                    <button class="play-button" disabled="@serverBusy" @onclick="ConnectServerAsync">@(serverBusy ? Text.ServerLoading : Text.Connect)</button>
                }
                else
                {
                    <span class="server-path">@serverFolder</span>
                    @if (serverError is not null)
                    {
                        <strong class="server-error" role="alert">@serverError</strong>
                    }
                    <div class="server-list" aria-label="@Text.ServerChoosePlaylist">
                        @if (ServerParentUrl is { } parentUrl)
                        {
                            <button disabled="@serverBusy" @onclick="() => BrowseServerAsync(parentUrl)">↑ @Text.ServerUp</button>
                        }
                        @foreach (var entry in serverEntries)
                        {
                            var current = entry;
                            <button disabled="@serverBusy" @onclick="() => OpenServerEntryAsync(current)">@(current.IsFolder ? "📁 " : "♪ ")@current.Name</button>
                        }
                        @if (serverEntries.Count == 0)
                        {
                            <span>@Text.ServerEmpty</span>
                        }
                    </div>
                }
            </section>
        </div>
    }
    @if (youTubeChooserVisible)
    {
        <div class="insert-overlay" style="@SubDialogOpacityVars" @onclick="CloseYouTubeChooser" @onclick:stopPropagation="true">
            <section class="insert-dialog youtube-chooser" @onclick:stopPropagation="true">
                <div class="control-dialog-header">
                    <span>@Text.YouTubeChooseVideo</span>
                    <button class="close-button" title="@Text.Close" @onclick="CloseYouTubeChooser">×</button>
                </div>
                @foreach (var chooserVideo in youTubeResults)
                {
                    <button class="youtube-result" @onclick="() => SelectYouTubeVideo(chooserVideo)">
                        <strong>@chooserVideo.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(chooserVideo.Channel))
                        {
                            <small>@chooserVideo.Channel</small>
                        }
                    </button>
                }
            </section>
        </div>
    }
    <div class="cover-stage @(PlaylistSplitActive ? "cover-stage-split" : null)"
         @onpointerdown="OnSwipeStart"
         @onpointerup="OnSwipeEndAsync"
         @onpointercancel="() => swipeStart = null"
         @onclick="ToggleControls">
        @if (selectedYouTubeVideo is { } video)
        {
            <iframe class="youtube-player" @ref="youtubeFrame" src="@YouTubeEmbedUrl(video.VideoId)"
                    title="@video.Title" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            @if (youTubeEmbedFailed)
            {
                <div class="youtube-fallback">
                    <span>@Text.YouTubeEmbedUnavailable</span>
                    <button @onclick="OpenYouTubeExternallyAsync">@Text.YouTubeOpenExternally</button>
                </div>
            }
        }
        else
        {
            <canvas class="cover-image" @ref="coverCanvas"></canvas>
            @if (string.IsNullOrWhiteSpace(coverUri))
            {
                <div class="cover-placeholder">♪</div>
            }
        }
    </div>
    @if (PlaylistSplitActive)
    {
        <div class="pane-resizer" title="@Text.PlaylistPaneResizerTitle" aria-label="@Text.PlaylistPaneResizerTitle"
             @onpointerdown="BeginPaneResize" @onclick:stopPropagation="true"></div>
    }
    @if (isDraggingPane)
    {
        <div class="pane-resize-overlay" @onpointermove="OnPaneResizeMove" @onpointerup="EndPaneResize"
             @onpointercancel="EndPaneResize" @onclick:stopPropagation="true"></div>
    }
    <div class="track-caption">
        <span class="track-caption-title" @onmouseenter="ShowControls">
            <span>@(Player.CurrentTrack?.Artist ?? "CoverPlayerMP")</span>
            <span class="caption-separator">—</span>
            <span>@(Player.CurrentTrack?.Title ?? Text.SelectPlaylist)</span>
        </span>
        @if (Player.CurrentTrack is not null)
        {
            @if (youTubeAvailable)
            {
                <button class="youtube-button" title="@Text.YouTubeButton" aria-label="@Text.YouTubeButton"
                        @onclick="OnYouTubeButtonClicked" @onclick:stopPropagation="true">YouTube</button>
            }
            <button class="info-button" title="@Text.TrackDetails" aria-label="@Text.TrackDetails"
                    @onclick="ShowTrackInfo" @onclick:stopPropagation="true">i</button>
        }
    </div>

    @if (controlsVisible)
    {
        <section class="control-dialog" style="@SubDialogOpacityVars" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@Text.PlayerControls</span>
                <button class="close-button" title="@Text.Settings" aria-label="@Text.Settings" @onclick="OpenOptions">
                    <svg viewBox="0 0 24 24" width="0.8em" height="0.8em" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6a.5.5 0 0 0 .1-.6l-2-3.5a.5.5 0 0 0-.6-.2l-2.5 1a7.3 7.3 0 0 0-1.7-1l-.4-2.6a.5.5 0 0 0-.5-.4h-4a.5.5 0 0 0-.5.4l-.4 2.6a7.3 7.3 0 0 0-1.7 1l-2.5-1a.5.5 0 0 0-.6.2l-2 3.5a.5.5 0 0 0 .1.6L4.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6a.5.5 0 0 0-.1.6l2 3.5a.5.5 0 0 0 .6.2l2.5-1a7.3 7.3 0 0 0 1.7 1l.4 2.6a.5.5 0 0 0 .5.4h4a.5.5 0 0 0 .5-.4l.4-2.6a7.3 7.3 0 0 0 1.7-1l2.5 1a.5.5 0 0 0 .6-.2l2-3.5a.5.5 0 0 0-.1-.6zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" />
                    </svg>
                </button>
                <button class="close-button" title="@Text.HideControls" aria-label="@Text.HideControls" @onclick="HideControls">×</button>
            </div>
            <div class="control-row timeline-row">
                <span>@FormatTime(displayPosition)</span>
                <input type="range"
                       @key="Player.CurrentIndex"
                       min="0"
                       max="@durationValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1"
                       value="@displayPosition.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onpointerdown="BeginSeeking"
                       @onpointerup="EndSeeking"
                       @onpointercancel="EndSeeking"
                       @oninput="OnSeekChanged" />
                <span>@FormatTime(Player.Duration)</span>
            </div>
            <div class="control-toolbar">
                <div class="control-buttons">
                <div class="playlist-buttons">
                <button @onclick="OpenPlaylistAsync"
                        title="@Text.OpenPlaylist" aria-label="@Text.OpenPlaylist">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5V9H6.2a1.5 1.5 0 0 0-1.4 1L3 15.5z" />
                                                <path d="M5.6 11a1 1 0 0 1 .9-.7h15.2a.8.8 0 0 1 .8 1l-2.1 7a1 1 0 0 1-1 .7H3.8a.8.8 0 0 1-.8-1z" />
                                            </svg>
                                        </button>
                @if (Player.SupportsServerPlaylist)
                                {
                                    <button @onclick="() => serverDialogVisible = true"
                                            title="@Text.OpenPlaylistFromServer" aria-label="@Text.OpenPlaylistFromServer">
                                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                             aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                            <path d="M6.5 19a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 17.4 9.1 4.5 4.5 0 0 1 17.5 19z" />
                                        </svg>
                                    </button>
                                }
                                <button @onclick="OpenEditor" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.EditPlaylist" aria-label="@Text.EditPlaylist">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <rect x="3" y="5" width="11" height="2" rx="1" />
                        <rect x="3" y="10" width="11" height="2" rx="1" />
                        <rect x="3" y="15" width="6" height="2" rx="1" />
                        <path d="M18.6 9.2l2.2 2.2-7.3 7.3-2.9.7.7-2.9z" />
                    </svg>
                </button>
                <button @onclick="OpenLibraryAsync"
                        title="@Text.SearchAudioFiles" aria-label="@Text.SearchAudioFiles">
                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round"
                         aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                        <circle cx="10" cy="10" r="6.5" />
                        <path d="M15 15l6 6" />
                    </svg>
                </button>
                </div>
                <div class="player-buttons">
                <button @onclick="PreviousAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.Previous" aria-label="@Text.Previous">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <rect x="4" y="4" width="3" height="16" rx="1" />
                                                <path d="M20 4.5v15a.8.8 0 0 1-1.2.7L8.5 12.7a.8.8 0 0 1 0-1.4l10.3-7.5a.8.8 0 0 1 1.2.7z" />
                                            </svg>
                                        </button>
                <button @onclick="RestartAsync" disabled="@(Player.CurrentTrack is null)"
                        title="@Text.Restart" aria-label="@Text.Restart">&#x21BA;&#xFE0E;</button>
                <button class="play-button" @onclick="TogglePauseAsync" disabled="@(Player.CurrentTrack is null)"
                        title="@(Player.IsPlaying ? Text.Pause : Text.Play)"
                        aria-label="@(Player.IsPlaying ? Text.Pause : Text.Play)">
                    @if (Player.IsPlaying)
                    {
                        <svg class="pause-icon" viewBox="0 0 24 24" width="1em" height="1em"
                             fill="currentColor" aria-hidden="true" focusable="false"
                             style="vertical-align: -0.125em;">
                            <rect x="5" y="4" width="5" height="16" rx="1" />
                            <rect x="14" y="4" width="5" height="16" rx="1" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                             aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                            <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                        </svg>
                    }
                </button>
                <button @onclick="NextAsync" disabled="@(Player.Tracks.Count == 0)"
                        title="@Text.Next" aria-label="@Text.Next">
                                            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"
                                                 aria-hidden="true" focusable="false" style="vertical-align: -0.125em;">
                                                <path d="M4 4.5v15a.8.8 0 0 0 1.2.7l10.3-7.5a.8.8 0 0 0 0-1.4L5.2 3.8A.8.8 0 0 0 4 4.5z" />
                                                <rect x="17" y="4" width="3" height="16" rx="1" />
                                            </svg>
                                        </button>
                </div>
                </div>
                <label class="setting-row setting-inline volume-setting">
                    <span class="setting-icon"
                           title="@Text.Volume"
                           aria-label="@Text.Volume">🔊</span>
                    <span class="setting-value">@Math.Round(Player.Volume * 100) %</span>
                    <input type="range" min="0" max="1" step="0.01"
                           title="@Text.VolumePercent(Math.Round(Player.Volume * 100))"
                           value="@Player.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @oninput="OnVolumeChanged" />
                </label>
            </div>
        </section>
    }

    @if (libraryVisible)
    {
        <section class="library-dialog" style="@SubDialogOpacityVars" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@Text.AudioFiles (@FilteredLibrary.Count() @Text.Of @libraryTracks.Count)</span>
                    @if (Player.LibraryTracksLoadedFromIndex)
                    {
                        <button class="close-button" title="@Text.RefreshAudioFiles" aria-label="@Text.RefreshAudioFiles" @onclick="RefreshLibraryAsync">
                            &#x21bb;
                        </button>
                    }
                <button class="close-button" title="@Text.Close" @onclick="CloseLibrary">×</button>
            </div>
            @if (libraryLoading)
            {
                <div class="library-status">@Text.ReadingAudioFilesCount(Player.LibraryTracksFound)</div>
            }

            else
            {
                <div class="library-table-wrapper">
                    <table class="library-table">
                        <thead>
                            <tr>
                                <th><input placeholder="@Text.Artist" @bind="artistFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="@Text.Title" @bind="titleFilter" @bind:event="oninput" /></th>
                                <th><input placeholder="@Text.DurationFilterPlaceholder" @bind="durationFilter" @bind:event="oninput" /></th>
                            </tr>
                            <tr>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Artist)">@Text.Artist@(SortIndicator(LibrarySortColumn.Artist))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Title)">@Text.Title@(SortIndicator(LibrarySortColumn.Title))</th>
                                <th class="sortable" @onclick="() => SortBy(LibrarySortColumn.Duration)">@Text.Duration@(SortIndicator(LibrarySortColumn.Duration))</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredLibrary)
                            {
                                <tr @onclick="() => SelectLibraryTrackAsync(item)">
                                    <td>@item.Track.Artist</td>
                                    <td>@item.Track.Title</td>
                                    <td>@FormatTime(item.Duration.TotalSeconds)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (editorVisible && !libraryVisible)
    {
        <section class="library-dialog @(playlistLayout == PlaylistLayout.Table ? null : "library-dialog-pane") @(editorHiddenForSubDialog ? "editor-hidden-for-subdialog" : null)" style="--editor-cover-size: @(EditorCoverSizeRem.ToString(System.Globalization.CultureInfo.InvariantCulture))rem; @SubDialogOpacityVars" @onclick="CloseEditorMenu" @onclick:stopPropagation="true">
            <div class="control-dialog-header">
                <span>@PlaylistEditorTitle (@FilteredPlaylist.Count() @Text.Of @Player.Tracks.Count)</span>
                <button class="close-button" title="@Text.Close" @onclick="CloseEditor">×</button>
            </div>
            <div class="editor-toolbar">
                <input class="editor-search" type="search" placeholder="@Text.Search"
                       @bind="editorSearch" @bind:event="oninput" />
                @if (Player.IsPlaylistModified)
                {
                    <button type="button" class="editor-save-button" title="@Text.SavePlaylist"
                            aria-label="@Text.SavePlaylist" @onclick="SaveEditorPlaylistAsync">
                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d="M4 3h13l3 3v15H4z" />
                            <path d="M8 3v6h8V3M8 21v-7h8v7" />
                        </svg>
                    </button>
                }
                <div class="editor-menu-container" @onclick:stopPropagation="true">
                        <button type="button" class="editor-menu-button" title="@Text.PlaylistEditorMenu"
                                aria-label="@Text.PlaylistEditorMenu" aria-expanded="@editorMenuVisible"
                                @onclick="ToggleEditorMenu">☰</button>
                        @if (editorMenuVisible)
                        {
                            <div class="editor-menu" role="menu">
                                <button role="menuitem" disabled="@(!CanRemoveSelected)" @onclick="RemoveSelectedTrackFromMenuAsync">
                                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M9 3h6l1 2h4v2H4V5h4z" />
                                        <path d="M6 9h12l-1 11.2a1 1 0 0 1-1 .8H8a1 1 0 0 1-1-.8z" />
                                    </svg>
                                    <span>@Text.RemoveTrack</span>
                                </button>
                                <button role="menuitem" @onclick="OpenLibraryFromMenuAsync"><span class="editor-menu-symbol">+</span><span>@Text.AddTrack</span></button>
                                <button role="menuitem" disabled="@(SelectedTrack is null)" @onclick="ShowSelectedTrackInfoFromMenu"><span class="editor-menu-symbol">i</span><span>@Text.TrackDetails</span></button>
                                <button role="menuitem" class="@(playlistLayout == PlaylistLayout.Table ? "active" : null)" @onclick="() => SetPlaylistLayoutFromMenuAsync(PlaylistLayout.Table)">
                                    <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                                        <rect x="3" y="4" width="18" height="16" rx="1.5" />
                                        <line x1="3" y1="9" x2="21" y2="9" />
                                        <line x1="3" y1="14" x2="21" y2="14" />
                                        <line x1="3" y1="19" x2="21" y2="19" />
                                    </svg>
                                    <span>@Text.PlaylistLayoutTable</span>
                                </button>
                                <button role="menuitem" class="@(playlistLayout == PlaylistLayout.Left ? "active" : null)" @onclick="() => SetPlaylistLayoutFromMenuAsync(PlaylistLayout.Left)">
                                    <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                                        <rect x="3" y="4" width="7" height="16" rx="1.2" />
                                        <line x1="13" y1="8" x2="21" y2="8" />
                                        <line x1="13" y1="16" x2="18" y2="16" />
                                    </svg>
                                    <span>@Text.PlaylistLayoutLeft</span>
                                </button>
                                <button role="menuitem" class="@(playlistLayout == PlaylistLayout.Right ? "active" : null)" @onclick="() => SetPlaylistLayoutFromMenuAsync(PlaylistLayout.Right)">
                                    <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                                        <rect x="14" y="4" width="7" height="16" rx="1.2" />
                                        <line x1="3" y1="8" x2="11" y2="8" />
                                        <line x1="6" y1="16" x2="11" y2="16" />
                                    </svg>
                                    <span>@Text.PlaylistLayoutRight</span>
                                </button>
                            </div>
                        }
                </div>
            </div>
            @if (selectionMode)
            {
                <div class="selection-toolbar">
                    <span>@Text.Selected(selectedIndices.Count)</span>
                    <button @onclick="SelectAllVisible" title="@Text.SelectAll" aria-label="@Text.SelectAll">@Text.All</button>
                    <button @onclick="EndSelectionMode" title="@Text.EndSelection" aria-label="@Text.EndSelection">×</button>
                </div>
            }
            @if (playlistLayout == PlaylistLayout.Table)
            {
                <div class="library-table-wrapper">
                    <table class="library-table editor-table">
                        <thead>
                            <tr>
                                <th class="editor-grip-cell"></th>
                                @if (selectionMode)
                                {
                                    <th class="editor-check-cell"></th>
                                }
                                <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Position)">@Text.No@(EditorSortIndicator(EditorSortColumn.Position))</th>
                                <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Artist)">@Text.Artist@(EditorSortIndicator(EditorSortColumn.Artist))</th>
                                <th class="sortable" @onclick="() => EditorSortBy(EditorSortColumn.Title)">@Text.Title@(EditorSortIndicator(EditorSortColumn.Title))</th>
                                <th>@Text.Cover</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (track, index) in FilteredPlaylist)
                            {
                                var details = GetEditorDetails(track);
                                 <tr @key="index" class="@EditorRowClass(index)" @onclick="e => SelectRow(index, e)"
                                    @onpointerdown="e => BeginLongPress(index, e)"
                                    @onpointermove="MoveLongPress"
                                    @onpointerup="CancelLongPress"
                                    @onpointercancel="CancelLongPress"
                                    @onpointerleave="CancelLongPress"
                                    @oncontextmenu:preventDefault="true"
                                    @ondragenter="() => dropIndex = index"
                                    @ondragover:preventDefault="true"
                                    @ondrop="() => DropTrack(index)">
                                    <td class="editor-grip-cell">
                                        <span class="editor-grip" draggable="@(editingIndex is null ? "true" : "false")"
                                               title="@Text.Move" aria-label="@Text.Move"
                                              @onpointerdown:stopPropagation="true"
                                              @onclick:stopPropagation="true"
                                              @ondragstart="() => BeginDrag(index)"
                                              @ondragend="EndDrag">≡</span>
                                    </td>
                                    @if (selectionMode)
                                    {
                                        <td class="editor-check-cell">
                                            <input type="checkbox" checked="@selectedIndices.Contains(index)" tabindex="-1"
                                                   aria-label="@Text.Select" style="pointer-events: none;" />
                                        </td>
                                    }
                                    <td class="editor-position" @onclick="() => { if (!selectionMode) BeginEditPosition(index); }">
                                        @if (editingIndex == index)
                                        {
                                            <input type="number" min="1" max="@Player.Tracks.Count"
                                                   @bind="editingValue" @bind:event="oninput"
                                                   @onkeydown="OnPositionKeyDown" @onblur="CommitPosition"
                                                   @onclick:stopPropagation="true" autofocus />
                                        }
                                        else
                                        {
                                            @(index + 1)
                                        }
                                    </td>
                                    <td>@track.Artist</td>
                                    <td>@track.Title</td>
                                    <td class="editor-cover-cell">
                                        <button class="editor-cover" title="@Text.PlayTrack" aria-label="@Text.PlayTrack"
                                                @onclick="() => PlayFromEditorAsync(index)">
                                            @if (details.Cover is not null)
                                            {
                                                <img src="@details.Cover" alt="" />
                                            }
                                            else
                                            {
                                                <span class="editor-cover-placeholder">♪</span>
                                            }
                                            <span class="editor-cover-play">
                                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                                    <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                                                </svg>
                                            </span>
                                            @if (details.Duration is { } duration)
                                            {
                                                <span class="editor-cover-duration">@FormatTime(duration.TotalSeconds)</span>
                                            }
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="library-table-wrapper playlist-list-wrapper">
                    <div class="playlist-list @(playlistLayout == PlaylistLayout.Right ? "align-right" : "align-left")">
                        @foreach (var (track, index) in FilteredPlaylist)
                        {
                            var details = GetEditorDetails(track);
                             <div @key="index" class="playlist-card @EditorRowClass(index)" @onclick="e => SelectRow(index, e)"
                                 @onpointerdown="e => BeginLongPress(index, e)"
                                 @onpointermove="MoveLongPress"
                                 @onpointerup="CancelLongPress"
                                 @onpointercancel="CancelLongPress"
                                 @onpointerleave="CancelLongPress"
                                 @oncontextmenu:preventDefault="true"
                                 @ondragenter="() => dropIndex = index"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => DropTrack(index)">
                                <div class="playlist-card-cover-wrap">
                                    @if (selectionMode)
                                    {
                                        <input class="playlist-card-select" type="checkbox" checked="@selectedIndices.Contains(index)" tabindex="-1"
                                               aria-label="@Text.Select" style="pointer-events: none;" />
                                    }
                                    <span class="playlist-card-position" @onclick="() => { if (!selectionMode) BeginEditPosition(index); }"
                                          @onclick:stopPropagation="true">
                                        @if (editingIndex == index)
                                        {
                                            <input type="number" min="1" max="@Player.Tracks.Count"
                                                   @bind="editingValue" @bind:event="oninput"
                                                   @onkeydown="OnPositionKeyDown" @onblur="CommitPosition"
                                                   @onclick:stopPropagation="true" autofocus />
                                        }
                                        else
                                        {
                                            @(index + 1)
                                        }
                                    </span>
                                    <span class="editor-grip" draggable="@(editingIndex is null ? "true" : "false")"
                                          title="@Text.Move" aria-label="@Text.Move"
                                          @onpointerdown:stopPropagation="true"
                                          @onclick:stopPropagation="true"
                                          @ondragstart="() => BeginDrag(index)"
                                          @ondragend="EndDrag">≡</span>
                                    <button class="editor-cover playlist-card-cover" title="@Text.PlayTrack" aria-label="@Text.PlayTrack"
                                            draggable="@(editingIndex is null ? "true" : "false")"
                                            @onclick="() => PlayFromEditorAsync(index)" @onclick:stopPropagation="true"
                                            @onpointerdown:stopPropagation="true"
                                            @ondragstart="() => BeginDrag(index)"
                                            @ondragend="EndDrag">
                                        @if (details.Cover is not null)
                                        {
                                            <img src="@details.Cover" alt="" draggable="false" />
                                        }
                                        else
                                        {
                                            <span class="editor-cover-placeholder">♪</span>
                                        }
                                        <span class="editor-cover-play">
                                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                                <path d="M6 4.5v15a.8.8 0 0 0 1.2.7l12-7.5a.8.8 0 0 0 0-1.4l-12-7.5A.8.8 0 0 0 6 4.5z" />
                                            </svg>
                                        </span>
                                        @if (details.Duration is { } duration)
                                        {
                                            <span class="editor-cover-duration">@FormatTime(duration.TotalSeconds)</span>
                                        }
                                    </button>
                                </div>
                                <div class="playlist-card-artist">@track.Artist</div>
                                <div class="playlist-card-title">@track.Title</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (removingTrack is not null)
    {
